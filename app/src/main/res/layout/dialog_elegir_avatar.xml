<?xml version="1.0" encoding="utf-8"?>
<!-- Elegir avatar de perfil (o subir una foto) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="@color/buti_superficie"
    app:cardCornerRadius="26dp"
    app:cardElevation="10dp"
    app:strokeColor="@color/buti_dorado"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Encabezado con la vista previa grande -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_practicar_encabezado"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="18dp"
            android:paddingBottom="14dp">

            <FrameLayout
                android:id="@+id/contenedorVistaAvatar"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:background="@drawable/bg_avatar_crema"
                android:clipToOutline="true"
                android:elevation="4dp">

                <ImageView
                    android:id="@+id/imgVistaAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/txtInicialesVistaAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:textColor="@color/buti_titulo"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Elige tu avatar"
                android:textColor="@color/buti_crema"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtNombreAvatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Toca uno para verlo"
                android:textColor="@color/buti_dorado"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Cuadrícula de avatares -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAvatares"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:clipToPadding="false"
            android:padding="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarAvatar"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:enabled="false"
                android:text="Usar este avatar"
                android:textAllCaps="false"
                android:textColor="@color/buti_sobre_acento"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/buti_exito"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubirFotoAvatar"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="Mejor subo una foto de mi galería"
                android:textAllCaps="false"
                android:textColor="@color/buti_acento"
                app:cornerRadius="16dp"
                app:strokeColor="@color/buti_acento" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuitarAvatar"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Quitar foto"
                    android:textAllCaps="false"
                    android:textColor="@color/buti_rosa" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelarAvatar"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cancelar"
                    android:textAllCaps="false"
                    android:textColor="@color/buti_texto_secundario" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
