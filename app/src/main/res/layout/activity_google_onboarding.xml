<?xml version="1.0" encoding="utf-8"?>
<!-- Bienvenida para cuentas de Google B'ÜTI.
     Los pasos 1 y 2 ya no se usan (los reemplaza el selector real de Google),
     pero se conservan vacíos porque el Java los busca por id. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/buti_fondo"
    android:fitsSystemWindows="true">

    <!-- Fondo cultural -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_fondo1" />

    <!-- Capa para mejorar la lectura -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/velo_fondo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Cenefa superior -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/ic_margen_otomi_verde" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingTop="16dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp">

                <!-- PASO 1 y PASO 2 (sin uso, se conservan por el id) -->
                <LinearLayout
                    android:id="@+id/layoutGooglePaso1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutGooglePaso2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <!-- =============== PASO 3: motivo =============== -->
                <LinearLayout
                    android:id="@+id/layoutGooglePaso3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <!-- Avatar con iniciales -->
                    <TextView
                        android:id="@+id/txtInicialesPaso3"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:background="@drawable/bg_avatar_crema"
                        android:gravity="center"
                        android:text="MG"
                        android:textColor="@color/buti_titulo"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSaludoPaso3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:text="¡Ya casi, María!"
                        android:textColor="@color/buti_titulo"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Cuéntanos un poco más para personalizar tu aprendizaje."
                        android:textColor="@color/buti_texto_secundario"
                        android:textSize="14sp" />

                    <!-- Tarjeta de opciones -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        app:cardBackgroundColor="@color/buti_superficie"
                        app:cardCornerRadius="26dp"
                        app:cardElevation="6dp"
                        app:strokeColor="@color/buti_borde"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_plandaverde" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="8dp"
                                    android:gravity="center"
                                    android:text="¿Por qué quieres aprender hñähñu?"
                                    android:textColor="@color/buti_texto"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_plandaverde" />

                            </LinearLayout>

                            <RadioGroup
                                android:id="@+id/rgMotivoAprendizaje"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:orientation="vertical">

                                <RadioButton
                                    android:id="@+id/rbRaices"
                                    android:layout_width="match_parent"
                                    android:layout_height="56dp"
                                    android:background="@drawable/bg_opcion_motivo"
                                    android:button="@null"
                                    android:gravity="center_vertical"
                                    android:paddingHorizontal="18dp"
                                    android:text="Raíces familiares"
                                    android:textColor="@color/sel_texto_motivo"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <RadioButton
                                    android:id="@+id/rbCuriosidad"
                                    android:layout_width="match_parent"
                                    android:layout_height="56dp"
                                    android:layout_marginTop="10dp"
                                    android:background="@drawable/bg_opcion_motivo"
                                    android:button="@null"
                                    android:gravity="center_vertical"
                                    android:paddingHorizontal="18dp"
                                    android:text="Curiosidad cultural"
                                    android:textColor="@color/sel_texto_motivo"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <RadioButton
                                    android:id="@+id/rbTrabajo"
                                    android:layout_width="match_parent"
                                    android:layout_height="56dp"
                                    android:layout_marginTop="10dp"
                                    android:background="@drawable/bg_opcion_motivo"
                                    android:button="@null"
                                    android:gravity="center_vertical"
                                    android:paddingHorizontal="18dp"
                                    android:text="Trabajo o escuela"
                                    android:textColor="@color/sel_texto_motivo"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                            </RadioGroup>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnContinuarMotivo"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:layout_marginTop="20dp"
                                android:text="Continuar"
                                android:textAllCaps="false"
                                android:textColor="@color/buti_sobre_acento"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                app:backgroundTint="@color/buti_acento"
                                app:cornerRadius="18dp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- =============== PASO 4: bienvenida =============== -->
                <LinearLayout
                    android:id="@+id/layoutGooglePaso4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_fiesta" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:cardBackgroundColor="@color/buti_superficie"
                        app:cardCornerRadius="26dp"
                        app:cardElevation="6dp"
                        app:strokeColor="@color/buti_dorado"
                        app:strokeWidth="1.5dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="22dp">

                            <TextView
                                android:id="@+id/txtInicialesPaso4"
                                android:layout_width="76dp"
                                android:layout_height="76dp"
                                android:background="@drawable/bg_avatar_crema"
                                android:gravity="center"
                                android:text="MG"
                                android:textColor="@color/buti_titulo"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtSaludoPaso4"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:gravity="center"
                                android:text="¡Bienvenida, María!"
                                android:textColor="@color/buti_titulo"
                                android:textSize="24sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center"
                                android:lineSpacingExtra="2dp"
                                android:text="Tu cuenta ya está lista. Empecemos tu primera lección de hñähñu."
                                android:textColor="@color/buti_texto_secundario"
                                android:textSize="14sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnComenzarLeccion"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:layout_marginTop="20dp"
                                android:text="Comenzar lección"
                                android:textAllCaps="false"
                                android:textColor="@color/buti_sobre_acento"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                app:backgroundTint="@color/buti_exito"
                                app:cornerRadius="18dp"
                                app:icon="@drawable/ic_flederecha"
                                app:iconGravity="textEnd"
                                app:iconPadding="10dp"
                                app:iconSize="22dp"
                                app:iconTint="@color/buti_sobre_acento" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </FrameLayout>

        </ScrollView>

        <!-- Cenefa inferior -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/ic_margen_otomi_verde" />

    </LinearLayout>

</FrameLayout>