<?xml version="1.0" encoding="utf-8"?>
<!-- Detalle de un estudiante (Admin) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/buti_superficie"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/buti_borde"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Encabezado con foto -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_lecciones"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="18dp">

                <FrameLayout
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:background="@drawable/bg_avatar_crema"
                    android:clipToOutline="true">

                    <ImageView
                        android:id="@+id/imgFotoDetalleAdmin"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/txtInicialesDetalleAdmin"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textColor="@color/buti_titulo"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                </FrameLayout>

                <TextView
                    android:id="@+id/txtNombreDetalleAdmin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textColor="@color/buti_crema"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtCorreoDetalleAdmin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/buti_crema"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Números -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtPuntosDetalleAdmin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat_juego"
                        android:gravity="center"
                        android:padding="10dp"
                        android:textColor="@color/buti_titulo"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtRachaDetalleAdmin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat_juego"
                        android:gravity="center"
                        android:padding="10dp"
                        android:textColor="@color/buti_titulo"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtMejorRachaDetalleAdmin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat_juego"
                        android:gravity="center"
                        android:padding="10dp"
                        android:textColor="@color/buti_titulo"
                        android:textSize="13sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txtUltimoDiaDetalleAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/buti_texto"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Avance por nivel"
                    android:textColor="@color/buti_titulo"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/contenedorNivelesDetalleAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCerrarDetalleAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="16dp"
                    android:text="Cerrar"
                    android:textAllCaps="false"
                    android:textColor="@color/buti_sobre_acento"
                    android:textStyle="bold"
                    app:backgroundTint="@color/buti_acento"
                    app:cornerRadius="16dp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</ScrollView>
