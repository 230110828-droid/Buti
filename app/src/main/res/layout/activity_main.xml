<?xml version="1.0" encoding="utf-8"?>
<!-- Contenedor principal de B'ÚTI -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fondo y contenido principal -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/buti_crema">

        <!-- Fondo decorativo -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_fondo1" />

        <!-- Contenido principal -->
        <LinearLayout
            android:id="@+id/contenido"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fitsSystemWindows="true"
            android:orientation="vertical">

            <!-- Cenefa superior -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="8dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_margen2" />

            <!-- Cabecera -->
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:navigationIcon="@drawable/ic_menu"
                app:navigationIconTint="@color/buti_marron"
                app:title="@string/app_titulo"
                app:titleCentered="true"
                app:titleTextAppearance="@style/TextAppearance.Buti.Titulo"
                app:titleTextColor="@color/buti_marron">

                <ImageView
                    android:id="@+id/imgLogoToolbar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="Logo de B'úti"
                    android:scaleType="fitCenter"
                    android:src="@drawable/principla_logo" />

            </com.google.android.material.appbar.MaterialToolbar>

            <!-- Pantallas de navegación -->
            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/nav_host"
                android:name="androidx.navigation.fragment.NavHostFragment"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:defaultNavHost="true"
                app:navGraph="@navigation/nav_graph" />

            <!-- Barra inferior redondeada. Va debajo del contenido (no encima),
                 así ninguna pantalla queda tapada por la barra. -->
            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_nav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="18dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_nav_inferior"
                android:elevation="12dp"
                app:itemIconSize="26dp"
                app:itemIconTint="@color/nav_item_color"
                app:itemTextColor="@color/nav_item_color"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/menu_bottom" />

            <!-- Cenefa inferior -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_margen3" />

        </LinearLayout>

    </FrameLayout>

    <!-- Menú lateral -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/drawer_fondo"
        app:headerLayout="@layout/drawer_header"
        app:itemBackground="@drawable/drawer_item_fondo"
        app:itemHorizontalPadding="20dp"
        app:itemIconPadding="16dp"
        app:itemIconTint="@color/drawer_item_color"
        app:itemTextColor="@color/drawer_item_color"
        app:menu="@menu/menu_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>