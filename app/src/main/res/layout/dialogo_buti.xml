<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="5dp"
    android:background="@android:color/transparent">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/buti_crema"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeColor="#D8C7AE"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <!-- Detalle cultural superior -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/ic_margen_otomi_verde" />

            <!-- Logo -->
            <ImageView
                android:id="@+id/imgLogoDialogo"
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:layout_marginTop="12dp"
                android:contentDescription="Logo de B'ÜTI"
                android:scaleType="fitCenter"
                android:src="@drawable/principla_logo" />

            <!-- Título -->
            <TextView
                android:id="@+id/tvTituloDialogo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="¡Bienvenido a B'ÜTI!"
                android:textColor="@color/buti_marron"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Mensaje -->
            <TextView
                android:id="@+id/tvMensajeDialogo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="Estamos preparando tu camino para aprender hñähñu."
                android:textColor="@color/buti_cafe"
                android:textSize="14sp" />

            <!-- Indicador de carga -->
            <ProgressBar
                android:id="@+id/progresoDialogo"
                style="?android:attr/progressBarStyle"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginTop="22dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/buti_verde"
                android:visibility="gone" />

            <!-- Botón -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="22dp"
                android:text="Continuar"
                android:textAllCaps="false"
                android:textColor="@color/buti_crema"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="@color/buti_verde"
                app:cornerRadius="16dp" />

            <!-- Detalle inferior -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="Aprende, descubre y conserva nuestras raíces."
                android:textColor="@color/buti_cafe"
                android:textSize="11sp"
                android:textStyle="italic" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:layout_marginTop="12dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:rotation="180"
                android:scaleType="fitXY"
                android:src="@drawable/ic_margen_otomi_verde" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
