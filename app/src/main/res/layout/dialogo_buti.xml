<?xml version="1.0" encoding="utf-8"?>
<!--
    Diálogo personalizado de B'ÜTI.
    Los ids NO cambiaron: tvTituloDialogo, tvMensajeDialogo,
    progresoDialogo, btnDialogo, imgLogoDialogo.
    Nuevo (opcional): btnDialogoSecundario, para confirmaciones.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/buti_crema"
        app:cardCornerRadius="28dp"
        app:cardElevation="10dp"
        app:strokeColor="@color/buti_dorado"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Cenefa bordada superior -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/ic_margen_otomi_verde" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="18dp"
                android:paddingEnd="24dp"
                android:paddingBottom="6dp">

                <!-- Personaje según el tipo de mensaje (lo cambia ButiDialogo) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    app:cardBackgroundColor="@color/buti_crema_oscuro"
                    app:cardCornerRadius="52dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/buti_dorado"
                    app:strokeWidth="2dp">

                    <ImageView
                        android:id="@+id/imgLogoDialogo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Colibrí de B'ÜTI"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/principla_logo" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Rombos decorativos -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="28dp"
                        android:layout_height="1.5dp"
                        android:background="@color/buti_dorado" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_rombo1" />

                    <View
                        android:layout_width="28dp"
                        android:layout_height="1.5dp"
                        android:background="@color/buti_dorado" />

                </LinearLayout>

                <!-- Título -->
                <TextView
                    android:id="@+id/tvTituloDialogo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="¡Bienvenido a B'ÜTI!"
                    android:textColor="@color/buti_vino"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <!-- Mensaje -->
                <TextView
                    android:id="@+id/tvMensajeDialogo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="Estamos preparando tu camino para aprender hñähñu."
                    android:textColor="@color/buti_cafe"
                    android:textSize="14sp" />

                <!-- Indicador de carga -->
                <ProgressBar
                    android:id="@+id/progresoDialogo"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="20dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/buti_vino"
                    android:visibility="gone" />

                <!-- Botón principal -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDialogo"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="22dp"
                    android:text="Continuar"
                    android:textAllCaps="false"
                    android:textColor="@color/buti_crema"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:backgroundTint="@color/buti_vino"
                    app:cornerRadius="18dp" />

                <!-- Botón secundario (solo en confirmaciones) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDialogoSecundario"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="4dp"
                    android:text="Cancelar"
                    android:textAllCaps="false"
                    android:textColor="@color/buti_cafe"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Frase inferior -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="Aprende, descubre y conserva nuestras raíces."
                    android:textColor="@color/buti_siena"
                    android:textSize="11sp"
                    android:textStyle="italic" />

            </LinearLayout>

            <!-- Cenefa bordada inferior -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="12dp"
                android:importantForAccessibility="no"
                android:rotation="180"
                android:scaleType="fitXY"
                android:src="@drawable/ic_margen_otomi_verde" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>