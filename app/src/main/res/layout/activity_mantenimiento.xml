<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de mantenimiento (se adapta a modo claro y oscuro) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/buti_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Cenefa -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/ic_margen_otomi_verde" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/buti_superficie"
            app:cardCornerRadius="28dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/buti_borde"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="28dp">

                <FrameLayout
                    android:layout_width="150dp"
                    android:layout_height="150dp">

                    <View
                        android:id="@+id/haloMantenimiento"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_halo_logo" />

                    <ImageView
                        android:id="@+id/imgLogoMantenimiento"
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_colibri_descansando" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Estamos arreglando el nido"
                    android:textColor="@color/buti_titulo"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="B'ÜTI está en mantenimiento para traerte nuevas palabras y mejoras para aprender hñähñu.\n\nVuelve en un ratito."
                    android:textColor="@color/buti_texto"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/txtEstadoMantenimiento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_practicar_etiqueta"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:text="Te avisaremos aquí en cuanto esté lista"
                    android:textColor="@color/buti_titulo"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerificarEstadoMantenimiento"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="22dp"
                    android:text="Revisar de nuevo"
                    android:textAllCaps="false"
                    android:textColor="@color/buti_sobre_acento"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/buti_exito"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCerrarSesionMantenimiento"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:text="Cerrar sesión"
                    android:textAllCaps="false"
                    android:textColor="@color/buti_rosa"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/buti_rosa" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>