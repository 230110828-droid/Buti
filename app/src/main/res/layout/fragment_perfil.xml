<?xml version="1.0" encoding="utf-8"?>
<!--
    Mi perfil · B'ÜTI
    Solo diseño: ids iguales. Modo claro y oscuro.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/buti_fondo"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_practicar_encabezado"
            android:elevation="4dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="18dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_rombo1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="7dp"
                    android:letterSpacing="0.14"
                    android:text="MI PERFIL"
                    android:textColor="@color/buti_dorado"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_rombo1" />

            </LinearLayout>

            <!-- Avatar con insignia de editar foto -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="14dp">

                <!-- Avatar: fotografía o iniciales -->
                <FrameLayout
                    android:id="@+id/contenedorAvatarPerfil"
                    android:layout_width="108dp"
                    android:layout_height="108dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_avatar_crema"
                    android:clickable="true"
                    android:clipToOutline="true"
                    android:contentDescription="Elegir avatar o fotografía de perfil"
                    android:elevation="3dp"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/imgFotoPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Fotografía de perfil"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/txtInicialesPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="MG"
                        android:textColor="@color/buti_titulo"
                        android:textSize="40sp"
                        android:textStyle="bold" />

                </FrameLayout>

                <!-- Insignia decorativa (el toque lo recibe el avatar) -->
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="2dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_flecha_reto"
                    android:elevation="6dp"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_editar"
                    app:tint="@color/buti_sobre_acento" />
            </FrameLayout>

            <!-- Nombre del usuario -->
            <TextView
                android:id="@+id/txtNombrePerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="María González"
                android:textColor="@color/buti_crema"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Toca tu foto para elegir un avatar"
                android:textColor="#F5DCCB"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Saludo en tarjeta suave -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_practicar_tarjeta"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_colibri_feliz" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hola, aprendiz"
                    android:textColor="@color/buti_titulo"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="¡Qué bueno verte de nuevo!"
                    android:textColor="@color/buti_resalte"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>

        <!-- Acciones del perfil -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="5dp"
                    android:layout_height="20dp"
                    android:background="@drawable/bg_barra_seccion" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:letterSpacing="0.08"
                    android:text="MI CUENTA"
                    android:textColor="@color/buti_titulo"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Editar perfil -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginBottom="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditarPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="start|center_vertical"
                    android:stateListAnimator="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="78dp"
                    android:paddingEnd="56dp"
                    android:text="Editar perfil"
                    android:textAlignment="viewStart"
                    android:textAllCaps="false"
                    android:textColor="@color/buti_titulo"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/buti_superficie"
                    app:cornerRadius="22dp"
                    app:rippleColor="@color/nivel_verde"
                    app:strokeColor="@color/buti_borde"
                    app:strokeWidth="1dp" />

                <!-- Iconos decorativos: no reciben toques, el botón de abajo sí -->
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_icono_perfil_verde"
                    android:elevation="1dp"
                    android:importantForAccessibility="no"
                    android:padding="11dp"
                    android:src="@drawable/ic_editar"
                    app:tint="@color/nivel_verde" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_practicar_etiqueta"
                    android:elevation="1dp"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_flecha_mini"
                    app:tint="@color/nivel_verde" />
            </FrameLayout>

            <!-- Cambiar contraseña -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginBottom="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCambiarContrasenaPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="start|center_vertical"
                    android:stateListAnimator="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="78dp"
                    android:paddingEnd="56dp"
                    android:text="Cambiar contraseña"
                    android:textAlignment="viewStart"
                    android:textAllCaps="false"
                    android:textColor="@color/buti_titulo"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/buti_superficie"
                    app:cornerRadius="22dp"
                    app:rippleColor="@color/nivel_naranja"
                    app:strokeColor="@color/buti_borde"
                    app:strokeWidth="1dp" />

                <!-- Iconos decorativos: no reciben toques, el botón de abajo sí -->
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_icono_perfil_naranja"
                    android:elevation="1dp"
                    android:importantForAccessibility="no"
                    android:padding="11dp"
                    android:src="@drawable/ic_candado4"
                    app:tint="@color/nivel_naranja" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_practicar_etiqueta"
                    android:elevation="1dp"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_flecha_mini"
                    app:tint="@color/nivel_naranja" />
            </FrameLayout>

            <!-- Configuración -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginBottom="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfiguracionPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="start|center_vertical"
                    android:stateListAnimator="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="78dp"
                    android:paddingEnd="56dp"
                    android:text="Configuración"
                    android:textAlignment="viewStart"
                    android:textAllCaps="false"
                    android:textColor="@color/buti_titulo"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/buti_superficie"
                    app:cornerRadius="22dp"
                    app:rippleColor="@color/nivel_siena"
                    app:strokeColor="@color/buti_borde"
                    app:strokeWidth="1dp" />

                <!-- Iconos decorativos: no reciben toques, el botón de abajo sí -->
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_icono_perfil_siena"
                    android:elevation="1dp"
                    android:importantForAccessibility="no"
                    android:padding="11dp"
                    android:src="@drawable/ic_estrella"
                    app:tint="@color/nivel_siena" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_practicar_etiqueta"
                    android:elevation="1dp"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_flecha_mini"
                    app:tint="@color/nivel_siena" />
            </FrameLayout>

            <!-- Separación antes de cerrar sesión -->
            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <!-- Cerrar sesión -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginBottom="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCerrarSesionPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="start|center_vertical"
                    android:stateListAnimator="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="78dp"
                    android:paddingEnd="56dp"
                    android:text="Cerrar sesión"
                    android:textAlignment="viewStart"
                    android:textAllCaps="false"
                    android:textColor="@color/nivel_rosa"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/buti_superficie"
                    app:cornerRadius="22dp"
                    app:rippleColor="@color/nivel_rosa"
                    app:strokeColor="@color/buti_borde"
                    app:strokeWidth="1dp" />

                <!-- Iconos decorativos: no reciben toques, el botón de abajo sí -->
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_icono_perfil_rosa"
                    android:elevation="1dp"
                    android:importantForAccessibility="no"
                    android:padding="11dp"
                    android:src="@drawable/ic_salida"
                    app:tint="@color/nivel_rosa" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_practicar_etiqueta"
                    android:elevation="1dp"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_flecha_mini"
                    app:tint="@color/nivel_rosa" />
            </FrameLayout>

        </LinearLayout>

        <!-- Pie -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_rombo2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="B'ÜTI · Nuestra lengua, nuestras raíces"
                android:textColor="@color/buti_resalte"
                android:textSize="12sp"
                android:textStyle="italic" />

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_rombo2" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>