<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5EFE3"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnVolverActividad"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_practicar_boton_secundario"
                android:contentDescription="Regresar"
                android:padding="11dp"
                android:src="@android:drawable/ic_media_previous"
                app:tint="#4F000B" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="8dp">

                <TextView
                    android:id="@+id/txtEtapaActividad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="ETAPA 1"
                    android:textColor="#4F000B"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.15"
                    android:text="APRENDE JUGANDO"
                    android:textColor="#8C4A2F"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtPuntosActividad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_practicar_etiqueta"
                android:paddingHorizontal="12dp"
                android:paddingVertical="9dp"
                android:text="⭐ 0"
                android:textColor="#4F000B"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- PROGRESO Y COLIBRÍ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tu avance"
                    android:textColor="#4F000B"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtNumeroPregunta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Actividad 1"
                    android:textColor="#8C4A2F"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/contenedorProgresoColibri"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="5dp">

                <ProgressBar
                    android:id="@+id/barraProgresoActividad"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="3dp"
                    android:max="10"
                    android:progress="0"
                    android:progressBackgroundTint="#D9C8A9"
                    android:progressTint="#6B7A4F" />

                <ImageView
                    android:id="@+id/imgColibriActividad"
                    android:layout_width="39dp"
                    android:layout_height="39dp"
                    android:layout_gravity="bottom|start"
                    android:contentDescription="Colibrí de progreso"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_colibri_normal" />
            </FrameLayout>
        </LinearLayout>

        <!-- PERSONAJE Y MENSAJE -->
        <LinearLayout
            android:id="@+id/contenedorPersonajeActividad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp"
            android:background="@drawable/bg_practicar_tarjeta">

            <ImageView
                android:id="@+id/imgPersonajeActividad"
                android:layout_width="94dp"
                android:layout_height="94dp"
                android:contentDescription="Personaje de Buti"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nina_pensando" />

            <TextView
                android:id="@+id/txtMensajeReaccionActividad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:gravity="center_vertical"
                android:text="¡Vamos a aprender! Tú puedes hacerlo."
                android:textColor="#4F000B"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- TEMPORIZADOR -->
        <TextView
            android:id="@+id/txtTemporizadorActividad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_practicar_etiqueta"
            android:paddingHorizontal="18dp"
            android:paddingVertical="8dp"
            android:text="⏱ 20 s"
            android:textColor="#4F000B"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- PRESENTACIÓN -->
        <TextView
            android:id="@+id/txtInstruccionActividad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="27dp"
            android:gravity="center"
            android:text="¡Vamos a aprender!"
            android:textColor="#4F000B"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDescripcionActividad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Observa, escucha y descubre nuevas palabras."
            android:textColor="#6D6258"
            android:textSize="14sp" />

        <!-- TARJETA PRINCIPAL -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardContenidoActividad"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="28dp"
            app:cardElevation="5dp"
            app:strokeColor="#E3D5BF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/imgActividad"
                    android:layout_width="145dp"
                    android:layout_height="135dp"
                    android:contentDescription="Imagen de la actividad"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtPalabraActividad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="¡Aprende algo nuevo!"
                    android:textColor="#4F000B"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtTraduccionActividad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="#6B7A4F"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btnEscucharActividad"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_practicar_audio"
                    android:contentDescription="Escuchar pronunciación"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play"
                    android:tint="@null" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- PREGUNTA -->
        <TextView
            android:id="@+id/txtPreguntaActividad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="27dp"
            android:gravity="center"
            android:text="Selecciona la respuesta correcta"
            android:textColor="#4F000B"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- PRÁCTICA DE PRONUNCIACIÓN -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHablarActividad"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="16dp"
            android:text="🎙 Repetir en voz alta"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:visibility="gone"
            app:backgroundTint="#6B7A4F"
            app:cornerRadius="18dp" />

        <!-- CONFIRMACIÓN MANUAL -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnValidarManualActividad"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="9dp"
            android:text="Ya practiqué esta palabra"
            android:textAllCaps="false"
            android:textColor="#4F000B"
            android:visibility="gone"
            app:backgroundTint="#E8DDC9"
            app:cornerRadius="17dp" />

        <!-- OPCIONES GENERALES -->
        <LinearLayout
            android:id="@+id/contenedorOpcionesActividad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpcion1"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="11dp"
                android:text="Opción 1"
                android:textAllCaps="false"
                android:textColor="#4F000B"
                android:textSize="16sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="17dp"
                app:strokeColor="#D9C8A9"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpcion2"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="11dp"
                android:text="Opción 2"
                android:textAllCaps="false"
                android:textColor="#4F000B"
                android:textSize="16sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="17dp"
                app:strokeColor="#D9C8A9"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpcion3"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="11dp"
                android:text="Opción 3"
                android:textAllCaps="false"
                android:textColor="#4F000B"
                android:textSize="16sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="17dp"
                app:strokeColor="#D9C8A9"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpcion4"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="5dp"
                android:text="Opción 4"
                android:textAllCaps="false"
                android:textColor="#4F000B"
                android:textSize="16sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="17dp"
                app:strokeColor="#D9C8A9"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <!-- COMPLETAR PALABRAS -->
        <LinearLayout
            android:id="@+id/contenedorCompletarActividad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtEspaciosPalabra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_practicar_tarjeta"
                android:gravity="center"
                android:minHeight="75dp"
                android:padding="14dp"
                android:text="＿ ＿ ＿ ＿"
                android:textColor="#4F000B"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Selecciona los caracteres en orden"
                android:textColor="#8C4A2F"
                android:textSize="14sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/contenedorLetrasActividad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="8dp" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- RELACIONAR -->
        <LinearLayout
            android:id="@+id/contenedorRelacionarActividad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/columnaEspanolActividad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="5dp" />

            <LinearLayout
                android:id="@+id/columnaHnahnuActividad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="5dp" />
        </LinearLayout>

        <!-- RETO DE MEMORIA -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRetoEspecialActividad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:strokeColor="#E3D5BF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtPistaRetoActividad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#4F000B"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/imgRetoActividad"
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:layout_marginTop="10dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- RESULTADO -->
        <TextView
            android:id="@+id/txtResultadoActividad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:background="@drawable/bg_practicar_tarjeta"
            android:gravity="center"
            android:padding="15dp"
            android:textColor="#6B7A4F"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- CONTINUAR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinuarActividad"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="28dp"
            android:enabled="false"
            android:text="Continuar →"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="#6B7A4F"
            app:cornerRadius="19dp" />

    </LinearLayout>
</ScrollView>