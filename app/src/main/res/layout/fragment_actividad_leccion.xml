<?xml version="1.0" encoding="utf-8"?>
<!--
    Pantalla de actividad de la lección.
    · Arriba (fijo): encabezado, colibrí de avance y personaje. Siempre se ven,
      así al responder se nota cómo avanza el colibrí y cómo reacciona la personita.
    · En medio (con scroll): la tarjeta y las opciones.
    · Abajo (fijo): panel de respuesta (bien / mal) y el botón para seguir.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/buti_fondo"
    android:orientation="vertical">

    <!-- ===================== PARTE FIJA DE ARRIBA ===================== -->
    <LinearLayout
        android:id="@+id/encabezadoFijoActividad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/buti_fondo"
        android:elevation="3dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnVolverActividad"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_boton_volver"
                android:contentDescription="Regresar"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_flecha_atras" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="8dp">

                <TextView
                    android:id="@+id/txtEtapaActividad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="ETAPA 1"
                    android:textColor="@color/buti_titulo"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.15"
                    android:text="APRENDE JUGANDO"
                    android:textColor="@color/buti_resalte"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtPuntosActividad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:background="@drawable/bg_chip_puntos"
                android:drawableStart="@drawable/ic_estrella_puntos"
                android:drawablePadding="5dp"
                android:gravity="center_vertical"
                android:text="0"
                android:textColor="@color/buti_titulo"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- PROGRESO Y COLIBRÍ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tu avance"
                    android:textColor="@color/buti_titulo"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtNumeroPregunta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Actividad 1"
                    android:textColor="@color/buti_resalte"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/contenedorProgresoColibri"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="5dp">

                <ProgressBar
                    android:id="@+id/barraProgresoActividad"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="3dp"
                    android:max="10"
                    android:progress="0"
                    android:progressBackgroundTint="@color/buti_borde"
                    android:progressTint="@color/buti_exito" />

                <ImageView
                    android:id="@+id/imgColibriActividad"
                    android:layout_width="39dp"
                    android:layout_height="39dp"
                    android:layout_gravity="bottom|start"
                    android:contentDescription="Colibrí de progreso"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_colibri_normal" />
            </FrameLayout>
        </LinearLayout>

        <!-- PERSONAJE Y MENSAJE -->
        <LinearLayout
            android:id="@+id/contenedorPersonajeActividad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:background="@drawable/bg_practicar_tarjeta">

            <ImageView
                android:id="@+id/imgPersonajeActividad"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="Personaje de Buti"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nina_pensando" />

            <TextView
                android:id="@+id/txtMensajeReaccionActividad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:gravity="center_vertical"
                android:maxLines="3"
                android:ellipsize="end"
                android:text="¡Vamos a aprender! Tú puedes hacerlo."
                android:textColor="@color/buti_titulo"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===================== CONTENIDO CON SCROLL ===================== -->
    <ScrollView
        android:id="@+id/scrollActividad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="6dp"
            android:paddingBottom="20dp">

            <!-- TEMPORIZADOR -->
            <TextView
                android:id="@+id/txtTemporizadorActividad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_practicar_etiqueta"
                android:paddingHorizontal="18dp"
                android:paddingVertical="8dp"
                android:drawableStart="@drawable/ic_temporizador"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:text="20 s"
                android:textColor="@color/buti_titulo"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- PRESENTACIÓN -->
            <TextView
                android:id="@+id/txtInstruccionActividad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="¡Vamos a aprender!"
                android:textColor="@color/buti_titulo"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDescripcionActividad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Observa, escucha y descubre nuevas palabras."
                android:textColor="@color/buti_texto_secundario"
                android:textSize="14sp" />

            <!-- TARJETA PRINCIPAL -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardContenidoActividad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="220dp"
                app:cardBackgroundColor="@color/buti_superficie"
                app:cardCornerRadius="28dp"
                app:cardElevation="5dp"
                app:strokeColor="@color/buti_borde"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="220dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp">

                    <ImageView
                        android:id="@+id/imgActividad"
                        android:layout_width="130dp"
                        android:layout_height="120dp"
                        android:contentDescription="Imagen de la actividad"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/txtPalabraActividad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginTop="6dp"
                        android:breakStrategy="balanced"
                        android:text="¡Aprende algo nuevo!"
                        android:textColor="@color/buti_titulo"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtTraduccionActividad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:breakStrategy="balanced"
                        android:gravity="center"
                        android:textColor="@color/buti_exito"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/btnEscucharActividad"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_practicar_audio"
                        android:contentDescription="Escuchar pronunciación"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_play" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- PREGUNTA -->
            <TextView
                android:id="@+id/txtPreguntaActividad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="Selecciona la respuesta correcta"
                android:textColor="@color/buti_titulo"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- PRÁCTICA DE PRONUNCIACIÓN -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHablarActividad"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="16dp"
                android:text="Repetir en voz alta"
                android:textAllCaps="false"
                android:textColor="@color/buti_sobre_acento"
                android:textSize="16sp"
                android:visibility="gone"
                app:backgroundTint="@color/buti_exito"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_microfono"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/buti_sobre_acento" />

            <!-- CONFIRMACIÓN MANUAL -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnValidarManualActividad"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="9dp"
                android:text="Ya practiqué esta palabra"
                android:textAllCaps="false"
                android:textColor="@color/buti_texto"
                android:visibility="gone"
                app:backgroundTint="@color/buti_superficie_alt"
                app:cornerRadius="17dp" />

            <!-- OPCIONES GENERALES -->
            <LinearLayout
                android:id="@+id/contenedorOpcionesActividad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpcion1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="11dp"
                    android:text="Opción 1"
                    android:textAllCaps="false"
                    android:textColor="@color/buti_titulo"
                    android:textSize="16sp"
                    android:maxLines="4"
                    app:backgroundTint="@color/buti_superficie"
                    app:cornerRadius="17dp"
                    app:strokeColor="@color/buti_borde"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpcion2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="11dp"
                    android:text="Opción 2"
                    android:textAllCaps="false"
                    android:textColor="@color/buti_titulo"
                    android:textSize="16sp"
                    android:maxLines="4"
                    app:backgroundTint="@color/buti_superficie"
                    app:cornerRadius="17dp"
                    app:strokeColor="@color/buti_borde"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpcion3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="11dp"
                    android:text="Opción 3"
                    android:textAllCaps="false"
                    android:textColor="@color/buti_titulo"
                    android:textSize="16sp"
                    android:maxLines="4"
                    app:backgroundTint="@color/buti_superficie"
                    app:cornerRadius="17dp"
                    app:strokeColor="@color/buti_borde"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpcion4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="5dp"
                    android:text="Opción 4"
                    android:textAllCaps="false"
                    android:textColor="@color/buti_titulo"
                    android:textSize="16sp"
                    android:maxLines="4"
                    app:backgroundTint="@color/buti_superficie"
                    app:cornerRadius="17dp"
                    app:strokeColor="@color/buti_borde"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- COMPLETAR PALABRAS -->
            <LinearLayout
                android:id="@+id/contenedorCompletarActividad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Casillas de la palabra: se crean desde el código -->
                <LinearLayout
                    android:id="@+id/contenedorEspaciosPalabra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_practicar_tarjeta"
                    android:gravity="center"
                    android:minHeight="80dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="12dp" />

                <TextView
                    android:id="@+id/txtAyudaQuitarLetra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Toca una letra de la palabra para quitarla"
                    android:textColor="@color/buti_texto_secundario"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="Toca las letras en orden"
                    android:textColor="@color/buti_resalte"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Banco de letras: se acomoda en filas que caben en la pantalla -->
                <LinearLayout
                    android:id="@+id/contenedorLetrasActividad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <!-- RELACIONAR -->
            <LinearLayout
                android:id="@+id/contenedorRelacionarActividad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/columnaEspanolActividad"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="5dp" />

                <LinearLayout
                    android:id="@+id/columnaHnahnuActividad"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="5dp" />
            </LinearLayout>

            <!-- RETO DE MEMORIA -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRetoEspecialActividad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/buti_superficie"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/buti_borde"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtPistaRetoActividad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/buti_titulo"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/imgRetoActividad"
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        android:layout_marginTop="10dp"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- ===================== PANEL FIJO DE ABAJO ===================== -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/buti_borde" />

    <LinearLayout
        android:id="@+id/panelRespuestaActividad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/buti_fondo"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp">

        <!-- RESULTADO (¡Correcto! / La respuesta era…) -->
        <TextView
            android:id="@+id/txtResultadoActividad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:paddingTop="4dp"
            android:textColor="@color/buti_exito"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- CONTINUAR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinuarActividad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="58dp"
            android:enabled="false"
            android:text="Continuar"
            android:textAllCaps="false"
            android:textColor="@color/buti_sobre_acento"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@color/buti_acento"
            app:cornerRadius="19dp"
            app:icon="@drawable/ic_flederecha"
            app:iconGravity="textEnd"
            app:iconPadding="10dp"
            app:iconSize="20dp"
            app:iconTint="@color/buti_sobre_acento" />
    </LinearLayout>

</LinearLayout>