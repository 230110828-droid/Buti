<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBF3EA"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- Bordado superior -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_margen2" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <!-- Logo de B'ÜTI -->
        <ImageView
            android:id="@+id/imgLogoBienvenida"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:contentDescription="Logo de B'ÜTI"
            android:scaleType="fitCenter"
            android:src="@drawable/principla_logo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="¡Bienvenido a B'ÜTI!"
            android:textColor="#70252B"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:text="Descubre la riqueza de nuestra cultura y aprende la lengua hñähñu de Ixmiquilpan."
            android:textColor="#654B42"
            android:textSize="17sp" />

        <!-- Ilustraciones culturales existentes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_rombo1" />

            <ImageView
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_rombo2" />

            <ImageView
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginStart="10dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_rombo3" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Nuestra lengua, nuestras raíces, nuestra identidad."
            android:textColor="#70252B"
            android:textSize="15sp"
            android:textStyle="italic" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <!-- Indicadores de bienvenida -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="24dp"
                android:layout_height="8dp"
                android:layout_margin="5dp"
                android:background="@drawable/indicador_activo" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_margin="5dp"
                android:background="@drawable/indicador_inactivo" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_margin="5dp"
                android:background="@drawable/indicador_inactivo" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <!-- Botón para continuar -->
        <Button
            android:id="@+id/btnComenzar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/btn_comenzar"
            android:elevation="3dp"
            android:text="Comenzar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Cultura y lengua hñähñu de Ixmiquilpan"
            android:textColor="#80685B"
            android:textSize="12sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <!-- Bordado inferior -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_margen2" />

    </LinearLayout>
</ScrollView>
