<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootBienvenida"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_bienvenida"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Bordado superior -->
    <ImageView
        android:id="@+id/margenSuperior"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/ic_margen_otomi_verde" />

    <!-- Contenido desplazable (en celulares chicos) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <!-- Espacio flexible: centra el contenido en pantallas altas -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Logo con halo -->
            <FrameLayout
                android:layout_width="196dp"
                android:layout_height="196dp">

                <View
                    android:id="@+id/viewHalo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_halo_logo" />

                <ImageView
                    android:id="@+id/imgLogoBienvenida"
                    android:layout_width="176dp"
                    android:layout_height="176dp"
                    android:layout_gravity="center"
                    android:contentDescription="Logo de B'ÜTI"
                    android:scaleType="fitCenter"
                    android:src="@drawable/principla_logo" />

            </FrameLayout>

            <!-- Etiqueta superior -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.14"
                android:text="VALLE DEL MEZQUITAL · HIDALGO"
                android:textColor="@color/buti_resalte"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Mensaje principal -->
            <TextView
                android:id="@+id/tvTituloBienvenida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:letterSpacing="0.01"
                android:text="¡Bienvenido a B'ÜTI!"
                android:textColor="@color/buti_titulo"
                android:textSize="29sp"
                android:textStyle="bold" />

            <!-- Detalle decorativo -->
            <View
                android:id="@+id/lineaAcento"
                android:layout_width="58dp"
                android:layout_height="4dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_linea_acento" />

            <!-- Texto de bienvenida -->
            <TextView
                android:id="@+id/tvDescripcionBienvenida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="Descubre, aprende y conecta con la riqueza de la lengua hñähñu y la cultura de Ixmiquilpan."
                android:textColor="@color/buti_texto_secundario"
                android:textSize="15sp" />

            <!-- Tarjeta cultural: postales de la región -->
            <LinearLayout
                android:id="@+id/cardCultura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_cultura"
                android:elevation="4dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="14dp">

                <!-- Invitación a explorar -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="UN VIAJE A NUESTRAS RAÍCES"
                    android:textColor="@color/buti_resalte"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgRombo1"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_rombo1" />

                    <ImageView
                        android:id="@+id/imgRombo2"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_marginHorizontal="14dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_rombo2" />

                    <ImageView
                        android:id="@+id/imgRombo3"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_rombo3" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="El Dexthi · El Nith · Panales"
                    android:textColor="@color/buti_texto"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Lema -->
            <TextView
                android:id="@+id/tvLemaBienvenida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Nuestra lengua, nuestras raíces,\nnuestra identidad."
                android:textColor="@color/buti_titulo"
                android:textSize="15sp"
                android:textStyle="italic" />

            <!-- Indicadores -->
            <LinearLayout
                android:id="@+id/llIndicadores"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/indicador1"
                    android:layout_width="24dp"
                    android:layout_height="8dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/indicador_activo" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/indicador_inactivo" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/indicador_inactivo" />

            </LinearLayout>

            <!-- Espacio flexible inferior -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Botón principal (con flecha a la derecha) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnComenzar"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/btn_comenzar"
                android:elevation="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Comenzar"
                android:textAllCaps="false"
                android:textColor="@color/buti_sobre_acento"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:icon="@drawable/ic_flederecha"
                app:iconGravity="textEnd"
                app:iconPadding="10dp"
                app:iconSize="22dp"
                app:iconTint="@color/buti_sobre_acento" />

            <!-- Texto inferior -->
            <TextView
                android:id="@+id/tvPieBienvenida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Cultura y lengua hñähñu de Ixmiquilpan"
                android:textColor="@color/buti_texto_secundario"
                android:textSize="12sp" />

        </LinearLayout>

    </ScrollView>

    <!-- Bordado inferior -->
    <ImageView
        android:id="@+id/margenInferior"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/ic_margen_otomi_verde" />

</LinearLayout>