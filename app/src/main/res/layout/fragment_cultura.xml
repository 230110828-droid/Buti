<?xml version="1.0" encoding="utf-8"?>
<!--
    Cultura · Ixmiquilpan · B'ÜTI
    Solo diseño: los ids se conservan igual. Modo claro y oscuro.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/buti_fondo"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <!-- ENCABEZADO PRINCIPAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_practicar_encabezado"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="22dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_rombo1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:letterSpacing="0.12"
                    android:text="VALLE DEL MEZQUITAL · HIDALGO"
                    android:textColor="@color/buti_dorado"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Ixmiquilpan"
                        android:textColor="@color/buti_crema"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="60dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_linea_dorada" />

                </LinearLayout>

                <ImageView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_colibri_volando" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:text="El corazón cultural de la región del Valle del Mezquital, cuna de la cultura hñähñu."
                android:textColor="#F5DCCB"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_buti_pastilla"
                android:letterSpacing="0.06"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp"
                android:text="IDENTIDAD  ·  CULTURA  ·  TRADICIÓN"
                android:textColor="@color/buti_vino"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- MAPA DESTACADO: al tocarla abre el detalle de Ixmiquilpan -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardExploraIxmiquilpan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/buti_superficie"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:rippleColor="@color/buti_dorado"
            app:strokeColor="@color/buti_dorado"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.12"
                        android:text="UBICACIÓN"
                        android:textColor="@color/buti_resalte"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Explora Ixmiquilpan"
                        android:textColor="@color/buti_titulo"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Descubre la riqueza de nuestra región. Toca el pin para ver el mapa."
                        android:textColor="@color/buti_texto_secundario"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- PIN: al tocarlo abre el mapa -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnMapaIxmiquilpan"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_marginStart="12dp"
                    android:clickable="true"
                    android:contentDescription="Ver Ixmiquilpan en el mapa"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/buti_acento"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="3dp"
                    app:rippleColor="@color/buti_dorado"
                    app:strokeColor="@color/buti_dorado"
                    app:strokeWidth="2dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:padding="20dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_ubicacion"
                        app:tint="@color/buti_sobre_acento" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="5dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_barra_seccion" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pueblos y colonias"
                    android:textColor="@color/buti_titulo"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Lugares que conservan nuestra identidad."
                    android:textColor="@color/buti_texto_secundario"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- EL DEXTHI -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPuebloDexthi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/buti_superficie"
            app:cardCornerRadius="22dp"
            app:cardElevation="3dp"
            app:rippleColor="@color/buti_dorado"
            app:strokeColor="@color/buti_borde"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="112dp"
                    android:layout_height="104dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/dexthi_letrero_cerros" />

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_practicar_etiqueta"
                        android:letterSpacing="0.08"
                        android:paddingStart="9dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="9dp"
                        android:paddingBottom="3dp"
                        android:text="01  ·  COMUNIDAD"
                        android:textColor="@color/buti_resalte"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="El Dexthi"
                        android:textColor="@color/buti_titulo"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Tradición textil"
                        android:textColor="@color/buti_texto_secundario"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:drawableEnd="@drawable/ic_flecha_mini"
                        android:drawablePadding="2dp"
                        android:drawableTint="@color/buti_resalte"
                        android:gravity="center_vertical"
                        android:text="Conocer lugar"
                        android:textColor="@color/buti_resalte"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- EL NITH -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPuebloNith"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/buti_superficie"
            app:cardCornerRadius="22dp"
            app:cardElevation="3dp"
            app:rippleColor="@color/buti_dorado"
            app:strokeColor="@color/buti_borde"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="112dp"
                    android:layout_height="104dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/nith_iglesia" />

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_practicar_etiqueta"
                        android:letterSpacing="0.08"
                        android:paddingStart="9dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="9dp"
                        android:paddingBottom="3dp"
                        android:text="02  ·  COMUNIDAD"
                        android:textColor="@color/buti_resalte"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="El Nith"
                        android:textColor="@color/buti_titulo"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Idioma vivo"
                        android:textColor="@color/buti_texto_secundario"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:drawableEnd="@drawable/ic_flecha_mini"
                        android:drawablePadding="2dp"
                        android:drawableTint="@color/buti_resalte"
                        android:gravity="center_vertical"
                        android:text="Conocer lugar"
                        android:textColor="@color/buti_resalte"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- PANALES -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPuebloPanales"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/buti_superficie"
            app:cardCornerRadius="22dp"
            app:cardElevation="3dp"
            app:rippleColor="@color/buti_dorado"
            app:strokeColor="@color/buti_borde"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="112dp"
                    android:layout_height="104dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/panales_valle_agricola" />

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_practicar_etiqueta"
                        android:letterSpacing="0.08"
                        android:paddingStart="9dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="9dp"
                        android:paddingBottom="3dp"
                        android:text="03  ·  COMUNIDAD"
                        android:textColor="@color/buti_resalte"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Panales"
                        android:textColor="@color/buti_titulo"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Gastronomía"
                        android:textColor="@color/buti_texto_secundario"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:drawableEnd="@drawable/ic_flecha_mini"
                        android:drawablePadding="2dp"
                        android:drawableTint="@color/buti_resalte"
                        android:gravity="center_vertical"
                        android:text="Conocer lugar"
                        android:textColor="@color/buti_resalte"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="5dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_barra_seccion" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lo que la distingue"
                    android:textColor="@color/buti_titulo"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="La esencia de nuestras raíces y tradiciones."
                    android:textColor="@color/buti_texto_secundario"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- CUADRÍCULA CULTURAL -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:columnCount="2"
            android:useDefaultMargins="false">

            <!-- EL MAGUEY -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTemaMaguey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/buti_superficie"
                app:cardCornerRadius="22dp"
                app:cardElevation="3dp"
                app:rippleColor="@color/nivel_verde"
                app:strokeColor="@color/nivel_verde"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_icono_reto"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_maguey2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="El maguey"
                        android:textColor="@color/buti_titulo"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:lineSpacingExtra="2dp"
                        android:minLines="2"
                        android:text="Da aguamiel, pulque y fibra de ixtle."
                        android:textColor="@color/buti_texto_secundario"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:drawableEnd="@drawable/ic_flecha_mini"
                        android:drawablePadding="2dp"
                        android:drawableTint="@color/nivel_verde"
                        android:gravity="center_vertical"
                        android:letterSpacing="0.06"
                        android:text="DESCUBRIR"
                        android:textColor="@color/nivel_verde"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- BORDADOS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTemaBordados"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/buti_superficie"
                app:cardCornerRadius="22dp"
                app:cardElevation="3dp"
                app:rippleColor="@color/nivel_rosa"
                app:strokeColor="@color/nivel_rosa"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_icono_reto"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_bordado3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Bordados"
                        android:textColor="@color/buti_titulo"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:lineSpacingExtra="2dp"
                        android:minLines="2"
                        android:text="Aves, flores y rombos hechos a mano."
                        android:textColor="@color/buti_texto_secundario"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:drawableEnd="@drawable/ic_flecha_mini"
                        android:drawablePadding="2dp"
                        android:drawableTint="@color/nivel_rosa"
                        android:gravity="center_vertical"
                        android:letterSpacing="0.06"
                        android:text="DESCUBRIR"
                        android:textColor="@color/nivel_rosa"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- GASTRONOMÍA -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTemaGastronomia"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/buti_superficie"
                app:cardCornerRadius="22dp"
                app:cardElevation="3dp"
                app:rippleColor="@color/nivel_naranja"
                app:strokeColor="@color/nivel_naranja"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_icono_reto"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_teflauta" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Gastronomía"
                        android:textColor="@color/buti_titulo"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:lineSpacingExtra="2dp"
                        android:minLines="2"
                        android:text="Barbacoa, mixiotes, escamoles y gusanos."
                        android:textColor="@color/buti_texto_secundario"
