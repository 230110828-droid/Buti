<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/buti_crema"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">

        <!-- ENCABEZADO PRINCIPAL -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/buti_vino"
            app:cardCornerRadius="28dp"
            app:cardElevation="5dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VALLE DEL MEZQUITAL  •  HIDALGO"
                    android:textColor="@color/buti_dorado"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:text="Ixmiquilpan"
                    android:textColor="@color/buti_crema"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:fontFamily="sans" />

                <View
                    android:layout_width="68dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="13dp"
                    android:background="@color/buti_dorado" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="El corazón cultural de la región del Valle del Mezquital, cuna de la cultura hñáhñu."
                    android:textColor="@color/buti_crema"
                    android:textSize="16sp"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_buti_pastilla"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="IDENTIDAD  •  CULTURA  •  TRADICIÓN"
                    android:textColor="@color/buti_vino"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- MAPA DESTACADO -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/buti_crema_oscuro"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/buti_siena"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UBICACIÓN"
                        android:textColor="@color/buti_siena"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Explora Ixmiquilpan"
                        android:textColor="@color/buti_negro"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Descubre la riqueza de nuestra región."
                        android:textColor="@color/buti_cafe"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    app:cardBackgroundColor="@color/buti_vino"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="19dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ubicacion"
                        android:scaleType="fitCenter"
                        app:tint="@color/buti_crema" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- SECCIÓN PUEBLOS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="5dp"
                android:layout_height="34dp"
                android:background="@color/buti_dorado" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pueblos y colonias"
                    android:textColor="@color/buti_vino"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Lugares que conservan nuestra identidad."
                    android:textColor="@color/buti_cafe"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- EL DEXTHI -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPuebloDexthi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/buti_crema_oscuro"
            app:cardCornerRadius="22dp"
            app:cardElevation="3dp"
            app:rippleColor="@color/buti_dorado"
            app:strokeColor="@color/buti_crema_oscuro"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="112dp"
                    android:layout_height="104dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/dexthi_letrero_cerros" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="01  /  COMUNIDAD"
                        android:textColor="@color/buti_siena"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="El Dexthi"
                        android:textColor="@color/buti_negro"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Tradición textil"
                        android:textColor="@color/buti_cafe"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="Conocer lugar  →"
                        android:textColor="@color/buti_vino"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- EL NITH -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPuebloNith"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/buti_crema_oscuro"
            app:cardCornerRadius="22dp"
            app:cardElevation="3dp"
            app:rippleColor="@color/buti_dorado"
            app:strokeColor="@color/buti_crema_oscuro"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="112dp"
                    android:layout_height="104dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/nith_iglesia" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="02  /  COMUNIDAD"
                        android:textColor="@color/buti_siena"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="El Nith"
                        android:textColor="@color/buti_negro"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Idioma vivo"
                        android:textColor="@color/buti_cafe"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="Conocer lugar  →"
                        android:textColor="@color/buti_vino"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- PANALES -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPuebloPanales"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/buti_crema_oscuro"
            app:cardCornerRadius="22dp"
            app:cardElevation="3dp"
            app:rippleColor="@color/buti_dorado"
            app:strokeColor="@color/buti_crema_oscuro"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="112dp"
                    android:layout_height="104dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/panales_valle_agricola" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="03  /  COMUNIDAD"
                        android:textColor="@color/buti_siena"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Panales"
                        android:textColor="@color/buti_negro"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Gastronomía"
                        android:textColor="@color/buti_cafe"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="Conocer lugar  →"
                        android:textColor="@color/buti_vino"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- SECCIÓN CULTURAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="5dp"
                android:layout_height="34dp"
                android:background="@color/buti_dorado" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lo que la distingue"
                    android:textColor="@color/buti_vino"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="La esencia de nuestras raíces y tradiciones."
                    android:textColor="@color/buti_cafe"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- CUADRÍCULA CULTURAL -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="2"
            android:useDefaultMargins="false">

            <!-- MAGUEY -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTemaMaguey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/buti_crema_oscuro"
                app:cardCornerRadius="22dp"
                app:cardElevation="3dp"
                app:rippleColor="@color/buti_dorado"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="17dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        app:cardBackgroundColor="@color/buti_crema"
                        app:cardCornerRadius="19dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="10dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_maguey2"
                            android:scaleType="fitCenter" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="El maguey"
                        android:textColor="@color/buti_vino"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Da aguamiel, pulque y fibra de ixtle."
                        android:textColor="@color/buti_cafe"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="DESCUBRIR  →"
                        android:textColor="@color/buti_siena"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- BORDADOS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTemaBordados"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/buti_crema_oscuro"
                app:cardCornerRadius="22dp"
                app:cardElevation="3dp"
                app:rippleColor="@color/buti_dorado"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="17dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        app:cardBackgroundColor="@color/buti_crema"
                        app:cardCornerRadius="19dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="10dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_bordado3"
                            android:scaleType="fitCenter" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Bordados"
                        android:textColor="@color/buti_vino"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Aves, flores y rombos hechos a mano."
                        android:textColor="@color/buti_cafe"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="DESCUBRIR  →"
                        android:textColor="@color/buti_siena"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- GASTRONOMÍA -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTemaGastronomia"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/buti_crema_oscuro"
                app:cardCornerRadius="22dp"
                app:cardElevation="3dp"
                app:rippleColor="@color/buti_dorado"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="17dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        app:cardBackgroundColor="@color/buti_crema"
                        app:cardCornerRadius="19dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="10dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_teflauta"
                            android:scaleType="fitCenter" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Gastronomía"
                        android:textColor="@color/buti_vino"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Barbacoa, mixiotes, escamoles y gusanos."
                        android:textColor="@color/buti_cafe"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="DESCUBRIR  →"
                        android:textColor="@color/buti_siena"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- SAN MIGUEL -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTemaSanMiguel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/buti_crema_oscuro"
                app:cardCornerRadius="22dp"
                app:cardElevation="3dp"
                app:rippleColor="@color/buti_dorado"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="17dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        app:cardBackgroundColor="@color/buti_crema"
                        app:cardCornerRadius="19dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="10dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_iglesia2"
                            android:scaleType="fitCenter" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="San Miguel"
                        android:textColor="@color/buti_vino"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Templo y exconvento del siglo XVI."
                        android:textColor="@color/buti_cafe"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="DESCUBRIR  →"
                        android:textColor="@color/buti_siena"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </GridLayout>

        <!-- CIERRE DECORATIVO -->
        <View
            android:layout_width="70dp"
            android:layout_height="3dp"
            android:layout_gravity="center"
            android:layout_marginTop="28dp"
            android:background="@color/buti_dorado" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Nuestras raíces viven en cada tradición."
            android:textColor="@color/buti_siena"
            android:textSize="13sp"
            android:textStyle="italic" />

