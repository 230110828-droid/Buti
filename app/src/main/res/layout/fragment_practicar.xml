<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/buti_crema"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- CUESTIONARIO / PREGUNTAS -->
        <LinearLayout
            android:id="@+id/layoutCuestionario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="visible">

            <!-- Header con Salir y Contador -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnCerrarQuiz"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circulo_atras"
                    android:clickable="true"
                    android:contentDescription="Salir"
                    android:focusable="true"
                    android:padding="12dp"
                    android:src="@drawable/ic_equis"
                    app:tint="@color/buti_negro" />

                <ProgressBar
                    android:id="@+id/pbPreguntas"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="14dp"
                    android:layout_marginHorizontal="14dp"
                    android:layout_weight="1"
                    android:max="10"
                    android:progress="1"
                    android:progressDrawable="@drawable/barra_carga" />

                <TextView
                    android:id="@+id/txtContadorPreguntas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1/10"
                    android:textColor="@color/buti_cafe"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Card de Pregunta -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="28dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <TextView
                        android:id="@+id/txtPreguntaQuiz"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="¿Cómo se dice ‘Rojo’?"
                        android:textColor="@color/buti_negro"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <!-- Botón de audio (id nuevo: btnAudioPregunta) -->
                    <ImageView
                        android:id="@+id/btnAudioPregunta"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_circulo_durazno"
                        android:clickable="true"
                        android:contentDescription="Escuchar"
                        android:focusable="true"
                        android:padding="16dp"
                        android:src="@drawable/ic_sonando"
                        app:tint="@color/buti_naranja" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Opciones de Respuesta -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnOpcionA"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="14dp"
                    android:backgroundTint="@color/white"
                    android:text="Kꞌangi"
                    android:textAllCaps="false"
                    android:textColor="@color/buti_negro"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="20dp"
                    app:strokeColor="@color/buti_crema_oscuro"
                    app:strokeWidth="1.5dp" />

                <Button
                    android:id="@+id/btnOpcionB"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="14dp"
                    android:backgroundTint="@color/white"
                    android:text="The̱ni"
                    android:textAllCaps="false"
                    android:textColor="@color/buti_negro"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="20dp"
                    app:strokeColor="@color/buti_crema_oscuro"
                    app:strokeWidth="1.5dp" />

                <Button
                    android:id="@+id/btnOpcionC"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="14dp"
                    android:backgroundTint="@color/white"
                    android:text="Tꞌaxi"
                    android:textAllCaps="false"
                    android:textColor="@color/buti_negro"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="20dp"
                    app:strokeColor="@color/buti_crema_oscuro"
                    app:strokeWidth="1.5dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSiguientePregunta"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/buti_naranja"
                android:text="Siguiente"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />
        </LinearLayout>

        <!-- RESULTADO / NIVEL SUPERADO -->
        <LinearLayout
            android:id="@+id/layoutResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_marginTop="32dp"
                android:importantForAccessibility="no"
                android:src="@drawable/deco_estrella"
                app:tint="@color/buti_dorado" />

            <TextView
                android:id="@+id/txtTituloResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="¡Muy bien!"
                android:textColor="@color/buti_vino"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSubtituloResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="¡Terminaste tu práctica!"
                android:textColor="@color/buti_siena"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Card de Puntuación -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tarjeta_blanca"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/txtCorrectasResultado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8/10"
                        android:textColor="@color/buti_verde"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="correctas"
                        android:textColor="@color/buti_cafe"
                        android:textSize="13sp" />
                </LinearLayout>

                <Space
                    android:layout_width="16dp"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tarjeta_blanca"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/txtPuntosResultado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+40"
                        android:textColor="@color/buti_naranja"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="puntos"
                        android:textColor="@color/buti_cafe"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnContinuarRacha"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:backgroundTint="@color/buti_naranja"
                android:text="Continuar"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/btnSeguirAprendiendo"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/buti_crema_oscuro"
                android:text="Seguir aprendiendo"
                android:textAllCaps="false"
                android:textColor="@color/buti_vino"
                android:textSize="17sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />
        </LinearLayout>

    </FrameLayout>
</ScrollView>