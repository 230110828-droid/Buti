<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="28dp">

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Editar perfil"
            android:textColor="@color/prog_naranja"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Avatar: las iniciales cambian al escribir el nombre -->
        <TextView
            android:id="@+id/txtInicialesEditar"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_avatar_progreso"
            android:gravity="center"
            android:text="MG"
            android:textColor="@color/prog_naranja"
            android:textSize="40sp"
            android:textStyle="bold" />

        <!-- Nombre -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Nombre"
            android:textColor="@color/prog_marron"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNombrePerfil"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:autofillHints="name"
            android:background="@drawable/bg_campo_perfil"
            android:hint="Tu nombre"
            android:imeOptions="actionNext"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="40"
            android:maxLines="1"
            android:paddingHorizontal="16dp"
            android:textColor="@color/buti_negro"
            android:textColorHint="#9A8F80"
            android:textSize="16sp" />

        <!-- Correo electrónico editable -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Correo electrónico"
            android:textColor="@color/prog_marron"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCorreoPerfil"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:autofillHints="emailAddress"
            android:background="@drawable/bg_campo_perfil"
            android:hint="correo@ejemplo.com"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:paddingHorizontal="16dp"
            android:textColor="@color/buti_negro"
            android:textColorHint="#9A8F80"
            android:textSize="16sp" />

        <!-- Nota sobre el correo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Puedes actualizar tu correo electrónico. Firebase podría solicitar que vuelvas a iniciar sesión."
            android:textColor="@color/buti_siena"
            android:textSize="12sp" />

        <!-- Cambiar contraseña -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCambiarContrasena"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:text="Cambiar contraseña"
            android:textAllCaps="false"
            android:textColor="@color/buti_cafe"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_candado4"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconSize="24dp"
            app:iconTint="@null"
            app:rippleColor="#33C97A2B"
            app:strokeColor="@color/buti_crema_oscuro"
            app:strokeWidth="1.5dp" />

        <!-- Guardar cambios -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarPerfil"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="28dp"
            android:text="Guardar cambios"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/buti_naranja"
            app:cornerRadius="20dp" />

        <!-- Cancelar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarPerfil"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="@color/buti_cafe"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/buti_crema_oscuro"
            app:cornerRadius="20dp" />

    </LinearLayout>

</ScrollView>
