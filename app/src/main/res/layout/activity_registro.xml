<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/buti_crema"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp">

        <!-- Logo de B'ÜTI -->
        <ImageView
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:src="@drawable/principla_logo"
            android:scaleType="fitCenter"
            android:contentDescription="Logo de B'ÜTI" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="B’ÚTI"
            android:textColor="@color/buti_vino"
            android:textSize="38sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Crea tu cuenta"
            android:textColor="@color/buti_cafe"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Empieza a aprender otomí"
            android:textColor="@color/buti_cafe"
            android:textSize="15sp" />

        <!-- Nombre completo -->
        <EditText
            android:id="@+id/edtNombreRegistro"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_campo_correo"
            android:hint="Nombre completo"
            android:inputType="textPersonName|textCapWords"
            android:maxLines="1"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/buti_cafe"
            android:textColorHint="@color/buti_cafe"
            android:textSize="15sp" />

        <!-- Correo electrónico -->
        <EditText
            android:id="@+id/edtCorreoRegistro"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_campo_contrasena"
            android:hint="Correo electrónico"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/buti_cafe"
            android:textColorHint="@color/buti_cafe"
            android:textSize="15sp" />

        <!-- Contraseña con opción de mostrar u ocultar -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutContrasenaRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="Contraseña"
            app:boxBackgroundMode="none"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/buti_cafe">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtContrasenaRegistro"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_campo_correo"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="@color/buti_cafe"
                android:textColorHint="@color/buti_cafe"
                android:textSize="15sp"
                android:autofillHints="newPassword" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Indicador del nivel de seguridad -->
        <TextView
            android:id="@+id/txtNivelContrasena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Seguridad de la contraseña"
            android:textColor="#5579A9"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/barraSeguridad"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:max="5"
            android:progress="0"
            android:progressBackgroundTint="#E8E8E8"
            android:progressTint="#D9534F" />

        <TextView
            android:id="@+id/txtReqLongitud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="○ Mínimo 8 caracteres"
            android:textColor="#777777"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtReqMayuscula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="○ Una letra mayúscula (A-Z)"
            android:textColor="#777777"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtReqMinuscula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="○ Una letra minúscula (a-z)"
            android:textColor="#777777"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtReqNumero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="○ Un número (0-9)"
            android:textColor="#777777"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtReqEspecial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="○ Un carácter especial (!@#$...)"
            android:textColor="#777777"
            android:textSize="12sp" />

        <!-- Confirmar contraseña con opción de mostrar u ocultar -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutConfirmarContrasenaRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="Confirmar contraseña"
            app:boxBackgroundMode="none"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/buti_cafe">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtConfirmarContrasenaRegistro"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_campo_contrasena"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="@color/buti_cafe"
                android:textColorHint="@color/buti_cafe"
                android:textSize="15sp"
                android:autofillHints="newPassword" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Aceptar términos -->
        <CheckBox
            android:id="@+id/chkTerminos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:buttonTint="@color/buti_verde"
            android:text="Acepto los términos y condiciones"
            android:textColor="@color/buti_cafe"
            android:textSize="14sp" />

        <!-- Crear cuenta -->
        <Button
            android:id="@+id/btnCrearCuentaRegistro"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_boton_login"
            android:backgroundTint="@null"
            android:text="Crear cuenta"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Volver al inicio de sesión -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Ya tienes una cuenta? "
                android:textColor="@color/buti_cafe"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtIniciarSesionRegistro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="Inicia sesión"
                android:textColor="@color/buti_rosa"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Decoración inferior -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:text="◇  ◆  ◇  ◆  ◇  ◆  ◇"
            android:textColor="@color/buti_verde"
            android:textSize="20sp" />

    </LinearLayout>

</ScrollView>
