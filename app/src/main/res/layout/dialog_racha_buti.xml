<?xml version="1.0" encoding="utf-8"?>
<!--
    Pantalla completa de racha (estilo Duolingo): aparece la primera vez
    que completas una lección, práctica o juego en el día.
    El maguey crece, el número cambia y cae confeti. Lo usa RachaButi.java
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raizRacha"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/buti_fondo"
    android:clickable="true"
    android:focusable="true">

    <!-- Cenefas arriba y abajo -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_gravity="top"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/ic_margen_otomi_verde" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_gravity="bottom"
        android:importantForAccessibility="no"
        android:rotation="180"
        android:scaleType="fitXY"
        android:src="@drawable/ic_margen_otomi_verde" />

    <LinearLayout
        android:id="@+id/contenidoRacha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/txtEtiquetaRacha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_practicar_etiqueta"
            android:paddingStart="14dp"
            android:paddingTop="5dp"
            android:paddingEnd="14dp"
            android:paddingBottom="5dp"
            android:text="◆  RACHA DEL DÍA  ◆"
            android:textColor="@color/buti_titulo"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- El maguey con su halo -->
        <FrameLayout
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_marginTop="10dp">

            <View
                android:id="@+id/haloRacha"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:background="@drawable/bg_halo_logo"
                tools:alpha="1" />

            <View
                android:id="@+id/destelloRacha"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:background="@drawable/bg_halo_logo" />

            <ImageView
                android:id="@+id/imgMagueyRacha"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:contentDescription="Maguey de tu racha"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_maguey_brote" />

        </FrameLayout>

        <!-- Número: el anterior sale y entra el nuevo -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="120dp"
            android:clipChildren="true">

            <TextView
                android:id="@+id/txtNumeroAnteriorRacha"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="0"
                android:textColor="@color/buti_texto_secundario"
                android:textSize="96sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtNumeroRacha"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/nivel_naranja"
                android:textSize="96sp"
                android:textStyle="bold"
                android:visibility="invisible"
                tools:visibility="visible" />

        </FrameLayout>

        <TextView
            android:id="@+id/txtDiasRacha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="días de racha"
            android:textColor="@color/buti_titulo"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Semana: un círculo por día -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tarjetaSemanaRacha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/buti_superficie"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/buti_borde"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/contenedorSemanaRacha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/txtMensajeRacha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="¡Empezaste tu racha!"
            android:textColor="@color/buti_texto"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinuarRacha"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="22dp"
            android:alpha="0"
            android:text="¡Seguir!"
            android:textAllCaps="false"
            android:textColor="@color/buti_sobre_acento"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@color/buti_exito"
            app:cornerRadius="18dp"
            tools:alpha="1" />

    </LinearLayout>

    <!-- Confeti encima de todo -->
    <com.itsoeh.sbsc.buti.ConfetiView
        android:id="@+id/confetiRacha"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
