<?xml version="1.0" encoding="utf-8"?>
<!-- Admin · Usuarios: buscar, ordenar y ver el avance de cada estudiante -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp">

    <EditText
        android:id="@+id/edtBuscarUsuarioAdmin"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:autofillHints=""
        android:background="@drawable/bg_campo_busqueda"
        android:hint="Buscar por nombre o correo"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/buti_texto"
        android:textColorHint="@color/buti_texto_secundario"
        android:textSize="15sp" />

    <!-- Ordenar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipsOrdenUsuariosAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />

    </HorizontalScrollView>

    <TextView
        android:id="@+id/txtCantidadUsuariosAdmin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:text="Cargando estudiantes…"
        android:textColor="@color/buti_texto_secundario"
        android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvUsuariosAdmin"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/txtVacioUsuariosAdmin"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="24dp"
        android:text="No se encontró ningún estudiante."
        android:textColor="@color/buti_texto_secundario"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>
