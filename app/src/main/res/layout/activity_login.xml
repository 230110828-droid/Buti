<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/buti_fondo"
    android:fitsSystemWindows="true">

    <!-- Fondo cultural -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_fondo1" />

    <!-- Capa para mejorar la lectura (crema en claro, vino en oscuro) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/velo_fondo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Cenefa superior -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/ic_margen_otomi_verde" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="12dp"
                android:paddingBottom="24dp">

                <!-- Logo -->
                <ImageView
                    android:id="@+id/imgLogoLogin"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:contentDescription="Logo de B'ÜTI"
                    android:scaleType="fitCenter"
                    android:src="@drawable/principla_logo" />

                <!-- Nombre de la aplicación -->
                <TextView
                    android:id="@+id/tvNombreLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.04"
                    android:text="B'ÜTI"
                    android:textColor="@color/buti_titulo"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <!-- Bienvenida -->
                <TextView
                    android:id="@+id/tvBienvenidaLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="¡Qué gusto tenerte de vuelta!"
                    android:textColor="@color/buti_texto_secundario"
                    android:textSize="15sp" />

                <!-- Tarjeta de inicio de sesión -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    app:cardBackgroundColor="@color/buti_superficie"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="6dp"
                    app:strokeColor="@color/buti_borde"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:paddingTop="24dp"
                        android:paddingBottom="22dp">

                        <!-- Encabezado -->
                        <TextView
                            android:id="@+id/tvTituloLogin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Inicia sesión"
                            android:textColor="@color/buti_titulo"
                            android:textSize="25sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDescripcionLogin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Ingresa tus datos para continuar aprendiendo."
                            android:textColor="@color/buti_texto_secundario"
                            android:textSize="14sp" />

                        <!-- Etiqueta correo -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="23dp"
                            android:layout_marginBottom="8dp"
                            android:text="Correo electrónico"
                            android:textColor="@color/buti_texto"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <!-- Campo correo -->
                        <LinearLayout
                            android:id="@+id/contenedorCorreoLogin"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:addStatesFromChildren="true"
                            android:background="@drawable/bg_campo_correo"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="14dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_msg" />

                            <EditText
                                android:id="@+id/edtCorreoLogin"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:background="@null"
                                android:hint="ejemplo@correo.com"
                                android:inputType="textEmailAddress"
                                android:maxLines="1"
                                android:paddingVertical="8dp"
                                android:textColor="@color/buti_texto"
                                android:textColorHint="@color/buti_texto_secundario"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <!-- Etiqueta contraseña -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="17dp"
                            android:layout_marginBottom="8dp"
                            android:text="Contraseña"
                            android:textColor="@color/buti_texto"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <!-- Campo contraseña -->
                        <LinearLayout
                            android:id="@+id/contenedorContrasenaLogin"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:addStatesFromChildren="true"
                            android:background="@drawable/bg_campo_contrasena"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingEnd="6dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_candado2" />

                            <EditText
                                android:id="@+id/edtContrasenaLogin"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:background="@null"
                                android:hint="Ingresa tu contraseña"
                                android:inputType="textPassword"
                                android:maxLines="1"
                                android:paddingVertical="8dp"
                                android:textColor="@color/buti_texto"
                                android:textColorHint="@color/buti_texto_secundario"
                                android:textSize="15sp" />

                            <ImageView
                                android:id="@+id/txtMostrarContrasena"
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:contentDescription="Mostrar u ocultar contraseña"
                                android:focusable="true"
                                android:padding="10dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_ojocerrado" />
                        </LinearLayout>

                        <!-- Recuperar contraseña -->
                        <TextView
                            android:id="@+id/txtOlvideContrasena"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="8dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="7dp"
                            android:text="¿Olvidaste tu contraseña?"
                            android:textColor="@color/buti_resalte"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <!-- Botón iniciar sesión -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnIniciarSesion"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="14dp"
                            android:text="Iniciar sesión"
                            android:textAllCaps="false"
                            android:textColor="@color/buti_sobre_acento"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/buti_acento"
                            app:cornerRadius="18dp"
                            app:elevation="3dp" />

                        <!-- Separador -->
                        <LinearLayout
                            android:id="@+id/separadorLogin"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1"
                                android:background="@color/buti_borde" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="14dp"
                                android:text="O continúa con"
                                android:textColor="@color/buti_texto_secundario"
                                android:textSize="12sp" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1"
                                android:background="@color/buti_borde" />
                        </LinearLayout>

                        <!-- Google -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGoogleLogin"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:text="Continuar con Google"
                            android:textAllCaps="false"
                            android:textColor="@color/buti_texto"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/buti_superficie_alt"
                            app:cornerRadius="18dp"
                            app:strokeColor="@color/buti_borde"
                            app:strokeWidth="1dp" />

                        <!-- Registro -->
                        <LinearLayout
                            android:id="@+id/contenedorRegistroLogin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="19dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="¿No tienes una cuenta?"
                                android:textColor="@color/buti_texto_secundario"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/txtRegistrate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:padding="5dp"
                                android:text="Regístrate"
                                android:textColor="@color/buti_resalte"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Frase inferior -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:text="Tu lengua, tu cultura, tus raíces."
                    android:textColor="@color/buti_titulo"
                    android:textSize="14sp"
                    android:textStyle="italic" />

            </LinearLayout>
        </ScrollView>

        <!-- Cenefa inferior -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/ic_margen_otomi_verde" />

    </LinearLayout>

</FrameLayout>