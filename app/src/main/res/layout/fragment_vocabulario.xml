        </GridLayout>

        <!-- BOTÓN VER MÁS (la flecha la cambia el Java) -->
        <TextView
            android:id="@+id/btnVerMasCategorias"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_boton_ver_mas"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_expandir"
            android:drawablePadding="8dp"
            android:drawableTint="@color/buti_titulo"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="22dp"
            android:paddingEnd="16dp"
            android:text="Ver más categorías"
            android:textColor="@color/buti_titulo"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- GRUPO 2 -->
        <TextView
            android:id="@+id/txtTituloGrupo2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_titulo_grupo2"
            android:paddingStart="15dp"
            android:text="Naturaleza y vida cotidiana"
            android:textColor="@color/buti_titulo"
            android:textSize="21sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <GridLayout
            android:id="@+id/gridGrupo2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:alignmentMode="alignMargins"
            android:columnCount="2"
            android:visibility="gone">

            <!-- PLANTAS -->
