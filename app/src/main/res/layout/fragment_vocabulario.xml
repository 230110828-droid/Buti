                            android:layout_width="43dp"
                            android:layout_height="43dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_manitas"
                            android:importantForAccessibility="no"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="Saludos"
                        android:textColor="@color/white"
                        android:textSize="17sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TIEMPO -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCatTiempo"
                android:layout_width="0dp"
                android:layout_height="145dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/buti_rosa"
                app:cardCornerRadius="25dp"
                app:cardElevation="4dp"
                app:rippleColor="#40FFFFFF"
                app:strokeColor="#40FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <FrameLayout
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:background="@drawable/bg_circulo_icono_vocab">

                        <ImageView
                            android:layout_width="43dp"
                            android:layout_height="43dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_reloj"
                            android:importantForAccessibility="no"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="Tiempo"
                        android:textColor="@color/white"
                        android:textSize="17sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </GridLayout>

        <!-- BOTON VER MAS -->
        <TextView
            android:id="@+id/btnVerMasCategorias"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Ver más categorías  ↓"
            android:textColor="@color/buti_rosa"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"/>

        <!-- GRUPO 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="18dp">

            <TextView
                android:id="@+id/txtTituloGrupo2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="Vida y cultura de Ixmiquilpan"
                android:textColor="@color/buti_azul"
                android:textSize="23sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <GridLayout
            android:id="@+id/gridGrupo2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            android:columnCount="2">

            <!-- PLANTAS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCatPlantas"
                android:layout_width="0dp"
                android:layout_height="145dp"
                android:layout_columnWeight="1"
