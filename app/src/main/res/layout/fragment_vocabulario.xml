<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollVocabulario"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="30dp">

        <!-- ENCABEZADO -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/buti_negro"
            app:cardCornerRadius="26dp"
            app:cardElevation="5dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="APRENDE Y DESCUBRE"
                    android:textColor="@color/buti_rosa"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Vocabulario"
                    android:textColor="@color/buti_crema"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="center"/>

                <View
                    android:layout_width="48dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="10dp"
                    android:background="@color/buti_rosa"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Conoce nuevas palabras y descubre la riqueza de la lengua hñähñu."
                    android:textColor="@color/buti_crema"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- GRUPO 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="25dp">

            <TextView
                android:id="@+id/txtTituloGrupo1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lo básico"
                android:textColor="@color/buti_azul"
                android:textSize="23sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Empieza con palabras de uso cotidiano"
                android:textColor="@color/buti_negro"
                android:textSize="13sp"
                android:alpha="0.75"
                android:layout_marginTop="3dp"/>

            <View
                android:layout_width="55dp"
                android:layout_height="3dp"
                android:layout_marginTop="9dp"
                android:background="@color/buti_rosa"/>

        </LinearLayout>

        <GridLayout
            android:id="@+id/gridGrupo1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="2">

            <!-- COLORES -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCatColores"
                android:layout_width="0dp"
                android:layout_height="145dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/buti_rosa"
                app:cardCornerRadius="25dp"
                app:cardElevation="4dp"
                app:rippleColor="#40FFFFFF"
                app:strokeColor="#40FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <FrameLayout
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:background="@drawable/bg_circulo_icono_vocab">

                        <ImageView
                            android:layout_width="43dp"
                            android:layout_height="43dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_rombo7"
                            android:importantForAccessibility="no"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="Colores"
                        android:textColor="@color/white"
                        android:textSize="17sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- NUMEROS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCatNumeros"
                android:layout_width="0dp"
                android:layout_height="145dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/buti_azul"
                app:cardCornerRadius="25dp"
                app:cardElevation="4dp"
                app:rippleColor="#40FFFFFF"
                app:strokeColor="#40FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <FrameLayout
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:background="@drawable/bg_circulo_icono_vocab">

                        <ImageView
                            android:layout_width="43dp"
                            android:layout_height="43dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_numeros"
                            android:importantForAccessibility="no"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="Números"
                        android:textColor="@color/white"
                        android:textSize="17sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SALUDOS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCatSaludos"
                android:layout_width="0dp"
                android:layout_height="145dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/buti_azul"
                app:cardCornerRadius="25dp"
                app:cardElevation="4dp"
                app:rippleColor="#40FFFFFF"
                app:strokeColor="#40FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
