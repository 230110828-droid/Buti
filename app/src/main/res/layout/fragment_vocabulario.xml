        </GridLayout>

        <!-- Familia ya no existe en el Excel. Tarjeta OCULTA solo para que tu Java
             no se cierre si todavia la busca. Borrala cuando quites esa parte del Java. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCatFamilia"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>