<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/buti_crema"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Puntos (arriba a la derecha) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_puntos"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/deco_estrella"
                    app:tint="@color/buti_dorado" />

                <TextView
                    android:id="@+id/txtPuntosLecciones"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="320"
                    android:textColor="@color/buti_siena"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal"
            android:text="Tu camino hñáhñu"
            android:textColor="@color/buti_siena"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- Ruta de Niveles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <!-- Nivel 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:translationX="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end|center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="4dp">

                </LinearLayout>

                <FrameLayout
                    android:layout_width="104dp"
                    android:layout_height="104dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardNivel1"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="48dp"
                        app:cardElevation="6dp"
                        app:strokeColor="#6B7F4A"
                        app:strokeWidth="4dp">

                        <ImageView
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_manitas" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Insignia de estado -->
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="0dp"
                        android:background="@drawable/bg_badge_hecho"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_paloma"
                        app:tint="@color/white" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start|center_vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="8dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="NIVEL 1"
                            android:textColor="#6B7F4A"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Saludos"
                            android:textColor="@color/buti_negro"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Camino punteado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="3dp"
                    android:background="@drawable/bg_punto_camino"
                    android:translationX="13.3dp" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="3dp"
                    android:background="@drawable/bg_punto_camino"
                    android:translationX="6.7dp" />

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="3dp"
                    android:background="@drawable/bg_punto_camino"
                    android:translationX="0.0dp" />

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="3dp"
                    android:background="@drawable/bg_punto_camino"
                    android:translationX="-6.7dp" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="3dp"
                    android:background="@drawable/bg_punto_camino"
                    android:translationX="-13.3dp" />
            </LinearLayout>

            <!-- Nivel 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:translationX="-20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end|center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="4dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="NIVEL 2"
                            android:textColor="#6B7F4A"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Números"
                            android:textColor="@color/buti_negro"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="104dp"
                    android:layout_height="104dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardNivel2"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="48dp"
                        app:cardElevation="6dp"
                        app:strokeColor="#6B7F4A"
                        app:strokeWidth="4dp">

                        <ImageView
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_piramide" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Insignia de estado -->
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="0dp"
                        android:background="@drawable/bg_badge_hecho"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_paloma"
                        app:tint="@color/white" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start|center_vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="8dp">

                </LinearLayout>
            </LinearLayout>

            <!-- Camino punteado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="3dp"
                    android:background="@drawable/bg_punto_camino"
                    android:translationX="-11.7dp" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="3dp"
                    android:background="@drawable/bg_punto_camino"
                    android:translationX="-3.3dp" />

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="3dp"
                    android:background="@drawable/bg_punto_camino"
                    android:translationX="5.0dp" />

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="3dp"
                    android:background="@drawable/bg_punto_camino"
                    android:translationX="13.3dp" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="3dp"
                    android:background="@drawable/bg_punto_camino"
                    android:translationX="21.7dp" />
            </LinearLayout>

            <!-- Nivel 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:translationX="30dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end|center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="4dp">

                </LinearLayout>

                <FrameLayout
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:background="@drawable/bg_halo_nivel">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardNivel3"
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="56dp"
                        app:cardElevation="12dp"
                        app:strokeColor="@color/buti_siena"
                        app:strokeWidth="5dp">

                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_humano" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Insignia de estado -->
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="10dp"
                        android:background="@drawable/bg_badge_actual"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_flederecha"
                        app:tint="@color/white" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start|center_vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="8dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="NIVEL 3"
                            android:textColor="@color/buti_siena"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Familia"
                            android:textColor="@color/buti_negro"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Camino punteado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="3dp"
                    android:background="@drawable/bg_punto_camino"
                    android:translationX="21.7dp" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="3dp"
                    android:background="@drawable/bg_punto_camino"
                    android:translationX="13.3dp" />

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="3dp"
                    android:background="@drawable/bg_punto_camino"
                    android:translationX="5.0dp" />

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="3dp"
                    android:background="@drawable/bg_punto_camino"
                    android:translationX="-3.3dp" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="3dp"
                    android:background="@drawable/bg_punto_camino"
                    android:translationX="-11.7dp" />
            </LinearLayout>

            <!-- Nivel 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:translationX="-20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end|center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="4dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="NIVEL 4"
                            android:textColor="#A89877"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Colores"
                            android:textColor="#8A7B66"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="104dp"
                    android:layout_height="104dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardNivel4"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="#F3ECDF"
                        app:cardCornerRadius="48dp"
                        app:cardElevation="1dp"
                        app:strokeColor="#E3D7C3"
                        app:strokeWidth="4dp">

                        <ImageView
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:layout_gravity="center"
                            android:alpha="0.45"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_rombo7" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Insignia de estado -->
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="0dp"
                        android:background="@drawable/bg_badge_bloq"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_candado2"
                        app:tint="@color/white" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start|center_vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="8dp">

                </LinearLayout>
            </LinearLayout>

            <!-- Camino punteado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="3dp"
                    android:background="@drawable/bg_punto_camino"
                    android:translationX="-21.7dp" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="3dp"
                    android:background="@drawable/bg_punto_camino"
                    android:translationX="-23.3dp" />

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="3dp"
                    android:background="@drawable/bg_punto_camino"
                    android:translationX="-25.0dp" />

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="3dp"
                    android:background="@drawable/bg_punto_camino"
                    android:translationX="-26.7dp" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="3dp"
                    android:background="@drawable/bg_punto_camino"
                    android:translationX="-28.3dp" />
            </LinearLayout>

            <!-- Nivel 5 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:translationX="-30dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end|center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="4dp">

                </LinearLayout>

                <FrameLayout
                    android:layout_width="104dp"
                    android:layout_height="104dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardNivel5"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="#F3ECDF"
                        app:cardCornerRadius="48dp"
                        app:cardElevation="1dp"
                        app:strokeColor="#E3D7C3"
                        app:strokeWidth="4dp">

                        <ImageView
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:layout_gravity="center"
                            android:alpha="0.45"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_venado" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Insignia de estado -->
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="0dp"
                        android:background="@drawable/bg_badge_bloq"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_candado2"
                        app:tint="@color/white" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start|center_vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="8dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="NIVEL 5"
                            android:textColor="#A89877"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Animales"
                            android:textColor="#8A7B66"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>