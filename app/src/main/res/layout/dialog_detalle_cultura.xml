<?xml version="1.0" encoding="utf-8"?>
<!--
    Detalle de comunidad o tema · Cultura · B'ÜTI
    Solo diseño: ids iguales. Se quitó el botón "Escuchar en otomí"
    (no hay audios). Modo claro y oscuro.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialogo_cultura"
    android:clipToOutline="true"
    android:fillViewport="true"
    android:outlineProvider="background"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- FOTO PRINCIPAL -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="260dp">

            <ImageView
                android:id="@+id/imgDetalleCultura"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/buti_superficie_alt"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                tools:src="@drawable/milpa_atardecer_nube" />

            <!-- DEGRADADO PARA QUE SE LEAN LOS TEXTOS -->
            <View
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_degradado_foto" />

            <!-- BOTÓN VOLVER -->
            <ImageView
                android:id="@+id/btnCerrarDetalleCultura"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|start"
                android:layout_margin="16dp"
                android:background="@drawable/bg_boton_volver"
                android:clickable="true"
                android:contentDescription="Volver"
                android:elevation="6dp"
                android:focusable="true"
                android:padding="11dp"
                android:src="@drawable/ic_flecha_atras" />

            <!-- CATEGORÍA -->
            <TextView
                android:id="@+id/txtCategoriaDetalleCultura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="22dp"
                android:layout_marginBottom="80dp"
                android:background="@drawable/bg_tag_naranja"
                android:paddingHorizontal="16dp"
                android:paddingVertical="7dp"
                android:text="Tradición textil"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- UBICACIÓN SOBRE LA FOTOGRAFÍA -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="22dp"
                android:layout_marginBottom="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_tag_ubicacion"
                    app:tint="@color/buti_dorado" />

                <TextView
                    android:id="@+id/txtUbicacionFotoCultura"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:letterSpacing="0.12"
                    android:text="VALLE DEL MEZQUITAL · HIDALGO"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </FrameLayout>

        <!-- CONTENIDO -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-27dp"
            app:cardBackgroundColor="@color/buti_superficie"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="22dp"
                android:paddingTop="24dp"
                android:paddingBottom="20dp">

                <!-- TÍTULO -->
                <TextView
                    android:id="@+id/txtTituloDetalleCultura"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="El Dexthi"
                    android:textColor="@color/buti_titulo"
                    android:textSize="29sp"
                    android:textStyle="bold" />

                <!-- DETALLE DECORATIVO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_plandaverde" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="2dp"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_linea_dorada" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_rombo1" />

                </LinearLayout>

                <!-- DESCRIPCIÓN -->
                <TextView
                    android:id="@+id/txtDescripcionDetalleCultura"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:lineSpacingExtra="6dp"
                    android:text="Comunidad de Ixmiquilpan, Hidalgo."
                    android:textColor="@color/buti_texto"
                    android:textSize="15sp" />

                <!-- TÍTULO DE ETIQUETAS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:letterSpacing="0.08"
                    android:text="DESCUBRE SU ESENCIA"
                    android:textColor="@color/buti_resalte"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- ETIQUETAS INTERACTIVAS (con icono real) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_practicar_etiqueta"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <!-- CULTURA -->
                    <TextView
                        android:id="@+id/tagCultura"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tag_naranja"
                        android:clickable="true"
                        android:drawableTop="@drawable/ic_tag_cultura"
                        android:drawablePadding="3dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingTop="9dp"
                        android:text="Cultura"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- TRADICIONES -->
                    <TextView
                        android:id="@+id/tagTradiciones"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tag_verde"
                        android:clickable="true"
                        android:drawableTop="@drawable/ic_tag_tradiciones"
                        android:drawablePadding="3dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingTop="9dp"
                        android:text="Tradiciones"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- UBICACIÓN -->
                    <TextView
                        android:id="@+id/tagUbicacion"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tag_siena"
                        android:clickable="true"
                        android:drawableTop="@drawable/ic_tag_ubicacion"
                        android:drawablePadding="3dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingTop="9dp"
                        android:text="Ubicación"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- CENEFA OTOMÍ -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="22dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_margen_otomi_verde" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Las raíces de nuestra tierra viven en su gente."
                    android:textColor="@color/buti_resalte"
                    android:textSize="12sp"
                    android:textStyle="italic" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>