<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="36dp"
    android:paddingEnd="16dp"
    android:paddingBottom="20dp">

    <!-- Marca de la app -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_bordado4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/app_titulo"
            android:textColor="@color/buti_crema"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/drawer_subtitulo"
        android:textColor="@color/buti_crema"
        android:textSize="12sp" />

    <!-- Tarjeta del usuario: al tocarla abre "Mi perfil" -->
    <LinearLayout
        android:id="@+id/contenedorPerfilDrawer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:contentDescription="Ver mi perfil"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- Avatar: foto o iniciales, con el colibrí como insignia -->
        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp">

            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_avatar_crema"
                android:clipToOutline="true"
                android:elevation="3dp">

                <ImageView
                    android:id="@+id/imgFotoDrawer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtInicialesDrawer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:text="U"
                    android:textColor="@color/buti_titulo"
                    android:textSize="32sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="bottom|end"
                android:elevation="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_colibri_feliz" />

        </FrameLayout>

        <TextView
            android:id="@+id/txtNombreDrawer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Usuario"
            android:textColor="@color/buti_crema"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Puntos y racha -->
        <TextView
            android:id="@+id/txtResumenDrawer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:drawableStart="@drawable/ic_estrella_puntos"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:text="0 puntos · racha 0 días"
            android:textColor="@color/buti_dorado"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:importantForAccessibility="no"
            android:text="Ver mi perfil ›"
            android:textColor="@color/buti_crema"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Cenefa separadora -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="14dp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/ic_margen_otomi_verde" />

</LinearLayout>