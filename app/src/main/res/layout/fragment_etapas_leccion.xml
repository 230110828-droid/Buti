<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5EFE3"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnVolverEtapas"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Regresar"
                android:src="@drawable/ic_fleizquierda"
                android:scaleType="fitCenter"
                android:padding="0dp"
                android:tint="@null" />

            <TextView
                android:id="@+id/txtTituloNivel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Nivel 1: Saludos"
                android:textColor="#4F000B"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPuntosEtapas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐ 0"
                android:textColor="#8C4A2F"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Tu aventura comienza aquí"
            android:textColor="#4F000B"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Completa cada desafío para avanzar en tu aprendizaje."
            android:textColor="#6D6258"
            android:textSize="15sp" />

        <!-- Progreso -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#E8DCC8"
            android:orientation="vertical"
            android:padding="15dp">

            <TextView
                android:id="@+id/txtProgresoEtapas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 de 5 etapas completadas"
                android:textColor="#4F000B"
                android:textStyle="bold"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/barraProgresoEtapas"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="10dp"
                android:max="5"
                android:progress="0"
                android:progressTint="#6B7A4F"
                android:progressBackgroundTint="#C8BBA7" />

        </LinearLayout>

        <!-- Etapa 1 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEtapa1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeColor="#D9C8A9"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="17dp">

                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:background="#E8EEDC"
                    android:src="@drawable/ic_maguey_brote"
                    android:contentDescription="Descubre" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ETAPA 1"
                        android:textColor="#8C4A2F"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Descubre"
                        android:textColor="#4F000B"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Conoce nuevas palabras y sus sonidos."
                        android:textColor="#6D6258"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtEstadoEtapa1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▶"
                    android:textColor="#6B7A4F"
                    android:textSize="22sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Etapa 2 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEtapa2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:strokeColor="#D9C8A9"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="17dp">

                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:background="#F8E9D5"
                    android:src="@drawable/ic_libro1"
                    android:contentDescription="Completa palabras" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ETAPA 2"
                        android:textColor="#8C4A2F"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Completa palabras"
                        android:textColor="#4F000B"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resuelve palabras incompletas."
                        android:textColor="#6D6258"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtEstadoEtapa2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒"
                    android:textSize="19sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Etapa 3 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEtapa3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:strokeColor="#D9C8A9"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="17dp">

                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:background="#E3EBF0"
                    android:src="@drawable/ic_manitas"
                    android:contentDescription="Relaciona" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ETAPA 3"
                        android:textColor="#8C4A2F"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Relaciona"
                        android:textColor="#4F000B"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Une imágenes, sonidos y significados."
                        android:textColor="#6D6258"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtEstadoEtapa3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒"
                    android:textSize="19sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Etapa 4 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEtapa4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:strokeColor="#D9C8A9"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="17dp">

                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:background="#F2E4E9"
                    android:src="@drawable/ic_trofeo"
                    android:contentDescription="Reto especial" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ETAPA 4"
                        android:textColor="#8C4A2F"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reto especial"
                        android:textColor="#4F000B"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Supera un desafío diferente."
                        android:textColor="#6D6258"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtEstadoEtapa4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒"
                    android:textSize="19sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Etapa 5 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEtapa5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="30dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:strokeColor="#D9C8A9"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="17dp">

                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:background="#F5EBCB"
                    android:src="@drawable/ic_cirestrella"
                    android:contentDescription="Evaluación final" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ETAPA 5"
                        android:textColor="#8C4A2F"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Evaluación final"
                        android:textColor="#4F000B"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Demuestra lo que has aprendido."
                        android:textColor="#6D6258"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtEstadoEtapa5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒"
                    android:textSize="19sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>