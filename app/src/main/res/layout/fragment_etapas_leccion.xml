<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/buti_fondo"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnVolverEtapas"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_boton_volver"
                android:contentDescription="Regresar"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_flecha_atras" />

            <TextView
                android:id="@+id/txtTituloNivel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_marginHorizontal="8dp"
                android:maxLines="2"
                android:text="Nivel 1: Saludos"
                android:textColor="@color/buti_titulo"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPuntosEtapas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_puntos"
                android:drawableStart="@drawable/ic_estrella_puntos"
                android:drawablePadding="5dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="0"
                android:textColor="@color/buti_titulo"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Encabezado: aventura y progreso -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_header_lecciones"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tu aventura comienza aquí"
                        android:textColor="@color/buti_crema"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Completa cada desafío para avanzar en tu aprendizaje."
                        android:textColor="@color/buti_crema_oscuro"
                        android:textSize="13sp" />

                </LinearLayout>

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_colibri_volando" />

            </LinearLayout>

            <!-- Progreso -->
            <TextView
                android:id="@+id/txtProgresoEtapas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="0 de 5 etapas completadas"
                android:textColor="@color/buti_dorado"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/barraProgresoEtapas"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="8dp"
                android:max="5"
                android:progress="0"
                android:progressBackgroundTint="#66FFFFFF"
                android:progressTint="@color/buti_dorado" />

        </LinearLayout>

        <!-- Etapa 1 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEtapa1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            app:cardBackgroundColor="@color/buti_superficie"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/buti_borde"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="17dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_icono_etapa1"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_maguey_brote"
                    android:contentDescription="Descubre" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ETAPA 1"
                        android:textColor="@color/buti_resalte"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Descubre"
                        android:textColor="@color/buti_titulo"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Conoce nuevas palabras y sus sonidos."
                        android:textColor="@color/buti_texto_secundario"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtEstadoEtapa1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableEnd="@drawable/ic_estado_jugar"
                    android:text="" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Etapa 2 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEtapa2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            app:cardBackgroundColor="@color/buti_superficie"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/buti_borde"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="17dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_icono_etapa2"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_libro1"
                    android:contentDescription="Completa palabras" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ETAPA 2"
                        android:textColor="@color/buti_resalte"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Completa palabras"
                        android:textColor="@color/buti_titulo"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resuelve palabras incompletas."
                        android:textColor="@color/buti_texto_secundario"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtEstadoEtapa2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableEnd="@drawable/ic_estado_bloqueada"
                    android:text="" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Etapa 3 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEtapa3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            app:cardBackgroundColor="@color/buti_superficie"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/buti_borde"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="17dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_icono_etapa3"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_manitas"
                    android:contentDescription="Relaciona" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ETAPA 3"
                        android:textColor="@color/buti_resalte"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Relaciona"
                        android:textColor="@color/buti_titulo"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Une imágenes, sonidos y significados."
                        android:textColor="@color/buti_texto_secundario"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtEstadoEtapa3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableEnd="@drawable/ic_estado_bloqueada"
                    android:text="" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Etapa 4 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEtapa4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            app:cardBackgroundColor="@color/buti_superficie"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/buti_borde"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="17dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_icono_etapa4"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_trofeo"
                    android:contentDescription="Reto especial" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ETAPA 4"
                        android:textColor="@color/buti_resalte"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reto especial"
                        android:textColor="@color/buti_titulo"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Supera un desafío diferente."
                        android:textColor="@color/buti_texto_secundario"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtEstadoEtapa4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableEnd="@drawable/ic_estado_bloqueada"
                    android:text="" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Etapa 5 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEtapa5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="30dp"
            app:cardBackgroundColor="@color/buti_superficie"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/buti_borde"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="17dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_icono_etapa5"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_cirestrella"
                    android:contentDescription="Evaluación final" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ETAPA 5"
                        android:textColor="@color/buti_resalte"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Evaluación final"
                        android:textColor="@color/buti_titulo"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Demuestra lo que has aprendido."
                        android:textColor="@color/buti_texto_secundario"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtEstadoEtapa5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableEnd="@drawable/ic_estado_bloqueada"
                    android:text="" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>