<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/buti_crema"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnVolverRompecabezas"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/ic_fondo1"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/buti_vino"
                android:textSize="32sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="ROMPECABEZAS"
                android:textColor="@color/buti_vino"
                android:textStyle="bold"
                android:textSize="20sp" />

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_colibri_feliz"
                android:scaleType="fitCenter"
                android:contentDescription="Colibrí B'ÜTI" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="TESOROS DE IXMIQUILPAN"
            android:textColor="@color/buti_naranja"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="Arma las postales bordadas del Valle del Mezquital"
            android:textColor="@color/buti_cafe"
            android:textSize="14sp" />

        <!-- SELECCIÓN DE IMÁGENES -->

        <LinearLayout
            android:id="@+id/layoutSeleccionRompecabezas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Elige tu lugar favorito"
                android:textColor="@color/buti_vino"
                android:textStyle="bold"
                android:textSize="19sp" />

            <LinearLayout
                android:id="@+id/contenedorImagenesRompecabezas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp" />

        </LinearLayout>

        <!-- JUEGO -->

        <LinearLayout
            android:id="@+id/layoutJuegoRompecabezas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtNombreRompecabezas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="Lugar seleccionado"
                android:textColor="@color/buti_vino"
                android:textStyle="bold"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/txtDificultadRompecabezas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="5dp"
                android:text="Dificultad: Fácil"
                android:textColor="@color/buti_cafe"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtMovimientosRompecabezas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ic_fondo1"
                    android:padding="12dp"
                    android:text="Movimientos: 0"
                    android:textColor="@color/buti_vino"
                    android:textStyle="bold"
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Arrastra una pieza sobre otra para intercambiarlas"
                android:textColor="@color/buti_cafe"
                android:textSize="13sp" />

            <GridLayout
                android:id="@+id/gridRompecabezas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="15dp"
                android:alignmentMode="alignMargins"
                android:columnCount="3"
                android:rowCount="3"
                android:useDefaultMargins="false" />

            <Button
                android:id="@+id/btnReiniciarRompecabezas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Mezclar piezas nuevamente"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/buti_vino" />

            <Button
                android:id="@+id/btnCambiarImagenRompecabezas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Elegir otro lugar"
                android:textAllCaps="false"
                android:textColor="@color/buti_vino"
                android:backgroundTint="@color/buti_dorado" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="B'ÜTI · Nuestra cultura, nuestro orgullo"
            android:textColor="@color/buti_naranja"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>
