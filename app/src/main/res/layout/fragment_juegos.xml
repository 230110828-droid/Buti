<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/buti_crema"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ZONA DE DIVERSIÓN"
                    android:textColor="@color/buti_naranja"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¡Vamos a jugar!"
                    android:textColor="@color/buti_vino"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Diviértete explorando y superando retos."
                    android:textColor="@color/buti_cafe"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <ImageView
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:src="@drawable/ic_colibri_feliz"
                android:scaleType="fitCenter"
                android:contentDescription="Colibrí de B'ÜTI" />

        </LinearLayout>

        <!-- Banner principal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_marginTop="22dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:background="@drawable/ic_fondo1">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TU MOMENTO DE DIVERSIÓN"
                    android:textColor="@color/buti_vino"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Descubre, juega y disfruta"
                    android:textColor="@color/buti_vino"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:layout_marginTop="5dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¡Elige tu próximo desafío!"
                    android:textColor="@color/buti_cafe"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <TextView
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:gravity="center"
                android:text="🎮"
                android:textSize="48sp" />

        </LinearLayout>

        <!-- Título de colección -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Elige un juego"
            android:textColor="@color/buti_vino"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="5dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pequeños retos para pasarla bien."
            android:textColor="@color/buti_cafe"
            android:textSize="13sp"
            android:layout_marginBottom="15dp" />

        <!-- Primera fila -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- MEMORAMA -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMemorama"
                android:layout_width="0dp"
                android:layout_height="190dp"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#FFF9F0"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeColor="#E6C47A"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="75dp"
                        android:layout_height="75dp"
                        android:gravity="center"
                        android:text="🃏"
                        android:textSize="48sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Memorama"
                        android:textColor="@color/buti_vino"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginTop="7dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Encuentra las parejas"
                        android:textColor="@color/buti_cafe"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JUGAR  →"
                        android:textColor="@color/buti_naranja"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ROMPECABEZAS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRompecabezas"
                android:layout_width="0dp"
                android:layout_height="190dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#F1F1E6"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeColor="#9AAB7B"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="75dp"
                        android:layout_height="75dp"
                        android:gravity="center"
                        android:text="🧩"
                        android:textSize="48sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rompecabezas"
                        android:textColor="@color/buti_vino"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="7dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Arma las ilustraciones"
                        android:textColor="@color/buti_cafe"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JUGAR  →"
                        android:textColor="@color/buti_verde"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Segunda fila -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginTop="14dp">

            <!-- ATRAPA LA PALABRA -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAtrapaPalabras"
                android:layout_width="0dp"
                android:layout_height="190dp"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#F9ECEB"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeColor="#D99A9C"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="75dp"
                        android:layout_height="75dp"
                        android:gravity="center"
                        android:text="🎯"
                        android:textSize="48sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Atrapa la palabra"
                        android:textColor="@color/buti_vino"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginTop="7dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pon a prueba tus reflejos"
                        android:textColor="@color/buti_cafe"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JUGAR  →"
                        android:textColor="@color/buti_rosa"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ENCUENTRA LAS DIFERENCIAS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDiferencias"
                android:layout_width="0dp"
                android:layout_height="190dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#EBF0F5"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeColor="#A4B6C8"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="75dp"
                        android:layout_height="75dp"
                        android:gravity="center"
                        android:text="🔎"
                        android:textSize="48sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Encuentra diferencias"
                        android:textColor="@color/buti_vino"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginTop="7dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Observa con atención"
                        android:textColor="@color/buti_cafe"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRÓXIMAMENTE"
                        android:textColor="@color/buti_azul"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Pie decorativo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="✦  B’ÜTI · Diversión con identidad  ✦"
            android:textColor="@color/buti_naranja"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="15dp" />

    </LinearLayout>

</ScrollView>
