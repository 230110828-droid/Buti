<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contenedorMemorama"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/buti_crema"
    android:padding="18dp">

    <!-- Encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnVolverMemorama"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/buti_vino"
            android:textSize="38sp"
            android:background="@android:color/transparent"
            android:contentDescription="Regresar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MEMORAMA"
                android:textColor="@color/buti_vino"
                android:textSize="23sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Encuentra todas las parejas"
                android:textColor="@color/buti_cafe"
                android:textSize="13sp" />

        </LinearLayout>

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_colibri_normal"
            android:scaleType="fitCenter"
            android:contentDescription="Colibrí B'ÜTI" />

    </LinearLayout>

    <!-- Decoración -->
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:background="@color/buti_dorado" />

    <!-- Estadísticas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="3"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="65dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/ic_fondo1">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TIEMPO"
                android:textColor="@color/buti_cafe"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtTiempoMemorama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/buti_vino"
                android:textSize="19sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="65dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/ic_fondo1">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MOVIMIENTOS"
                android:textColor="@color/buti_cafe"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtMovimientosMemorama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/buti_vino"
                android:textSize="19sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="65dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/ic_fondo1">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PAREJAS"
                android:textColor="@color/buti_cafe"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtParejasMemorama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 6"
                android:textColor="@color/buti_vino"
                android:textSize="19sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- Mensaje del juego -->
    <TextView
        android:id="@+id/txtMensajeMemorama"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="¡Encuentra las imágenes iguales!"
        android:textColor="@color/buti_cafe"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- Tablero -->
    <GridLayout
        android:id="@+id/gridMemorama"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="3"
        android:rowCount="4"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="false"
        android:padding="3dp" />

    <!-- Botón reiniciar -->
    <TextView
        android:id="@+id/btnReiniciarMemorama"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="⟳  Reiniciar partida"
        android:textColor="@color/buti_crema"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@color/buti_vino"
        android:elevation="3dp" />

</LinearLayout>
