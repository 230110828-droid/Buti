<?xml version="1.0" encoding="utf-8"?>
<!--
    Memorama · B'ÜTI
    Solo diseño: ids iguales. Modo claro y oscuro.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contenedorMemorama"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/buti_fondo"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnVolverMemorama"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_boton_volver"
            android:clickable="true"
            android:contentDescription="Regresar"
            android:focusable="true"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_flecha_atras" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="MEMORAMA"
                android:textColor="@color/buti_titulo"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Encuentra todas las parejas"
                android:textColor="@color/buti_texto_secundario"
                android:textSize="12sp" />

        </LinearLayout>

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Colibrí B'ÜTI"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_colibri_normal" />

    </LinearLayout>

    <!-- Decoración -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_linea_dorada" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_rombo1" />

        <View
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_linea_dorada"
            android:rotation="180" />

    </LinearLayout>

    <!-- Estadísticas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="1"
            android:background="@drawable/bg_stat_juego"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_temporizador" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:letterSpacing="0.06"
                    android:text="TIEMPO"
                    android:textColor="@color/buti_texto_secundario"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtTiempoMemorama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="00:00"
                android:textColor="@color/buti_titulo"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_stat_juego"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_movimientos" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:letterSpacing="0.06"
                    android:text="MOVIMIENTOS"
                    android:textColor="@color/buti_texto_secundario"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtMovimientosMemorama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0"
                android:textColor="@color/buti_titulo"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="1"
            android:background="@drawable/bg_stat_juego"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_req_ok"
                    app:tint="@color/buti_exito" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:letterSpacing="0.06"
                    android:text="PAREJAS"
                    android:textColor="@color/buti_texto_secundario"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtParejasMemorama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0 / 6"
                android:textColor="@color/buti_titulo"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- Mensaje del juego -->
    <TextView
        android:id="@+id/txtMensajeMemorama"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_practicar_etiqueta"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:text="¡Encuentra las imágenes iguales!"
        android:textColor="@color/buti_titulo"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Tablero -->
    <GridLayout
        android:id="@+id/gridMemorama"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:alignmentMode="alignMargins"
        android:background="@drawable/bg_tablero_juego"
        android:columnCount="3"
        android:padding="6dp"
        android:rowCount="4"
        android:useDefaultMargins="false" />

    <!-- Botón reiniciar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReiniciarMemorama"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Reiniciar partida"
        android:textAllCaps="false"
        android:textColor="@color/buti_sobre_acento"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/buti_acento"
        app:cornerRadius="18dp"
        app:icon="@drawable/ic_reiniciar"
        app:iconGravity="textStart"
        app:iconPadding="10dp"
        app:iconSize="24dp"
        app:iconTint="@null" />

</LinearLayout>