<?xml version="1.0" encoding="utf-8"?>
<!-- Ojo del campo de contraseña: abierto = contraseña oculta, cerrado = contraseña visible -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_checked="true">
        <layer-list>
            <item
                android:width="24dp"
                android:height="24dp"
                android:drawable="@drawable/ic_ojocerrado"
                android:gravity="center" />
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item
                android:width="24dp"
                android:height="24dp"
                android:drawable="@drawable/ic_ojoabierto"
                android:gravity="center" />
        </layer-list>
    </item>

</selector>
