<?xml version="1.0" encoding="utf-8"?>
<!-- Botón Comenzar MODO CLARO: vino a vino vivo, más oscuro al presionar. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#3A0008" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="0"
                android:startColor="#4F000B"
                android:endColor="#9E1E33" />
        </shape>
    </item>
</selector>