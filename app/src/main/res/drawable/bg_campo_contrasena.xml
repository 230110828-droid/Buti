<?xml version="1.0" encoding="utf-8"?>
<!-- Campo de texto MODO CLARO: se ilumina en dorado al escribir. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFDF8" />
            <stroke android:width="2dp" android:color="#F2A900" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFBF7" />
            <stroke android:width="1.5dp" android:color="#C9D0B8" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>