<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de carga redondeada con degradado dorado a naranja -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/buti_crema_oscuro" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient
                    android:angle="0"
                    android:endColor="@color/buti_naranja"
                    android:startColor="@color/buti_dorado" />
                <corners android:radius="10dp" />
            </shape>
        </clip>
    </item>
</layer-list>