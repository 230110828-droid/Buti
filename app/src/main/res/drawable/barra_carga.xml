<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de carga MODO CLARO: vino a rosa sobre crema. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#80FFF8EC" />
            <stroke android:width="1dp" android:color="#C97A2B" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="8dp" />
                <gradient
                    android:angle="0"
                    android:startColor="#4F000B"
                    android:endColor="#D6336C" />
            </shape>
        </clip>
    </item>
</layer-list>