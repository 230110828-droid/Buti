<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de cada palabra MODO CLARO: franja dorada a la izquierda -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#F2A900" />
        </shape>
    </item>
    <item android:left="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#FFFAF0" />
            <stroke android:width="1dp" android:color="#E8C9AD" />
        </shape>
    </item>
</layer-list>
