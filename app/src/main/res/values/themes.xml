<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        DayNight: ahora la app puede ser clara u oscura según lo que elijas
        en Configuración (o según el celular).
        Los colores buti_* cambian solos con values-night/colors.xml.
    -->
    <style name="Base.Theme.Buti" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/buti_naranja</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/buti_verde</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/buti_superficie</item>
        <item name="colorOnSurface">@color/buti_texto</item>
        <item name="android:colorBackground">@color/buti_fondo</item>
    </style>

    <style name="Theme.Buti" parent="Base.Theme.Buti" />

    <!-- Accesibilidad: "Texto en negrita" (se activa en Configuración). -->
    <style name="ThemeOverlay.Buti.TextoNegrita" parent="">
        <item name="android:textViewStyle">@style/Widget.Buti.TextoNegrita</item>
    </style>

    <style name="Widget.Buti.TextoNegrita" parent="Widget.MaterialComponents.TextView">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Buti.Titulo" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>