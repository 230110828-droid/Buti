<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de cada palabra MODO OSCURO: franja dorada a la izquierda -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#FFC857" />
        </shape>
    </item>
    <item android:left="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#2B1116" />
            <stroke android:width="1dp" android:color="#5E2A34" />
        </shape>
    </item>
</layer-list>
