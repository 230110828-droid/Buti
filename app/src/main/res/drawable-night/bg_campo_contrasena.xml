<?xml version="1.0" encoding="utf-8"?>
<!-- Campo de texto MODO OSCURO: se ilumina en dorado al escribir. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#3D1A21" />
            <stroke android:width="2dp" android:color="#FFC857" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33141A" />
            <stroke android:width="1.5dp" android:color="#5E6B4A" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>