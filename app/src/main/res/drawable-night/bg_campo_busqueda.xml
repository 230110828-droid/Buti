<?xml version="1.0" encoding="utf-8"?>
<!-- Buscador MODO OSCURO: borde dorado cuando estás escribiendo -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#2B1116" />
            <stroke android:width="2dp" android:color="#FFC857" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#2B1116" />
            <stroke android:width="1dp" android:color="#5E2A34" />
        </shape>
    </item>
</selector>
